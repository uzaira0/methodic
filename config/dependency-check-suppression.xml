<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
    <!--
        OWASP Dependency-Check suppression file for Chronicle.
        Add false positives or accepted risks here with justification.

        Example:
        <suppress>
            <notes>False positive - not using the vulnerable feature</notes>
            <cve>CVE-YYYY-NNNNN</cve>
        </suppress>
    -->

    <!-- ===================================================================
         Build-time static-analysis tooling (NOT shipped with the backend).
         These vulnerable jars are bundled by Checkstyle / SpotBugs and only
         appear on the `checkstyle` / `spotbugs` Gradle configurations. They
         run on the developer/CI machine at build time and are never deployed
         in the chronicle-server runtime image, so they pose no risk to the
         PHI backend. Suppressions are scoped to the exact build-tool GAV so
         any real (shipped) occurrence of these libraries would still fail.
         Verified 2026-06-22 via dependency-check report projectReferences:
           guava-19.0      <= chronicle-api:checkstyle
           log4j-*-2.25.2  <= chronicle-api:spotbugs
         ==================================================================== -->

    <suppress>
        <notes><![CDATA[
            Guava 19.0 is bundled by Checkstyle 7.4 (build-time linter on the
            `checkstyle` configuration only) — not on any shipped/runtime
            classpath. CVE-2023-2976 (insecure temp-file/dir) is not reachable
            from the build use of Checkstyle. Accepted build-tool risk.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/com\.google\.guava/guava@19\.0$</packageUrl>
        <cve>CVE-2023-2976</cve>
    </suppress>

    <suppress>
        <notes><![CDATA[
            Log4j 2.25.2 (log4j-core) is bundled by SpotBugs (build-time static
            analysis on the `spotbugs` configuration only) — not on any
            shipped/runtime classpath. The backend logs via its own (non-Log4j)
            stack. CVE-2026-34478/34479/34480 are not reachable from the build
            use of SpotBugs. Accepted build-tool risk.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.apache\.logging\.log4j/log4j-core@2\.25\.2$</packageUrl>
        <cve>CVE-2026-34478</cve>
        <cve>CVE-2026-34479</cve>
        <cve>CVE-2026-34480</cve>
    </suppress>

    <suppress>
        <notes><![CDATA[
            Log4j 2.25.2 (log4j-api) is bundled by SpotBugs (build-time static
            analysis on the `spotbugs` configuration only) — not on any
            shipped/runtime classpath. Accepted build-tool risk.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.apache\.logging\.log4j/log4j-api@2\.25\.2$</packageUrl>
        <cve>CVE-2026-34479</cve>
    </suppress>

    <!-- ===================================================================
         CPE false-positive: org.glassfish.expressly:expressly is the Jakarta
         Expression Language (EL) reference implementation. Dependency-Check
         mis-assigns it the CPE `cpe:2.3:a:eclipse:glassfish` purely on the
         shared "glassfish" vendor string, so it inherits GlassFish
         APPLICATION-SERVER advisories (e.g. CVE-2026-2586, CVE-2026-2587,
         CVE-2023-5763, CVE-2024-9329). Expressly is not GlassFish; it ships no
         servlet container, admin console, or the components those CVEs affect.
         Suppressing the erroneous CPE (not individual CVEs) is the correct fix:
         it drops every advisory that flows from the bad vendor match — present
         and future — while a genuine expressly-vendored advisory (correct CPE)
         would still fail the gate. Confirmed 2026-07-18: no real advisory exists
         for org.glassfish.expressly:expressly 5.0.0.
         See docs/security/pentest-2026-findings.md (F-3).
         ==================================================================== -->
    <suppress>
        <notes><![CDATA[
            Expressly (Jakarta EL RI) is not GlassFish. The eclipse:glassfish CPE
            is a vendor-string collision; the associated GlassFish app-server CVEs
            are unreachable. Suppress the mis-assigned CPE, not the CVEs.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.glassfish\.expressly/expressly@.*$</packageUrl>
        <cpe>cpe:/a:eclipse:glassfish</cpe>
    </suppress>

    <!-- ===================================================================
         CVE-2026-53914 — Kotlin build-cache-metadata unsafe deserialization
         (CWE-502). The vulnerable code path lives in the Kotlin COMPILER /
         Gradle build-cache toolchain, NOT in the kotlin-stdlib / kotlin-reflect
         RUNTIME libraries that ship inside the chronicle backend image. The
         `cpe:2.3:a:jetbrains:kotlin` match is correct at the product level but
         over-broad at the component level: DC applies the whole-product CVE to
         every kotlin-* jar, including the shipped runtime stdlib/reflect, which
         do not contain the build-cache code. Exploitation requires a poisoned
         local build cache — JetBrains' own CNA scores it 6.7 MEDIUM (AV:L),
         vs NVD's 9.8 (AV:N). This is the same risk class as the guava/log4j
         build-tool suppressions above (build-time only, not shipped at runtime).

         The real fix is upgrading the Kotlin toolchain to >= 2.4.20, which is
         NOT YET RELEASED as a stable version (only 2.4.20-Beta1 exists on Maven
         Central as of 2026-07-18; latest stable is 2.4.10, still affected). We
         will not pin the HIPAA backend build to a beta compiler. This is a
         CVE-scoped (not CPE-scoped) suppression so any genuine future stdlib
         advisory still fails the gate; it becomes inert once we upgrade to a
         fixed version (a fixed version is simply not flagged). Remove this entry
         at the Kotlin 2.4.20 GA upgrade. See docs/security/pentest-2026-findings.md.
         ==================================================================== -->
    <suppress>
        <notes><![CDATA[
            CVE-2026-53914 is a Kotlin build-cache-metadata deserialization flaw
            in the compiler/Gradle toolchain, not in the shipped kotlin-stdlib /
            kotlin-reflect runtime. Build-time only (JetBrains AV:L, 6.7 Medium).
            No stable fix released yet (2.4.20 is unreleased); track the upgrade.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.jetbrains\.kotlin/kotlin-(stdlib|stdlib-jdk7|stdlib-jdk8|reflect)@.*$</packageUrl>
        <cve>CVE-2026-53914</cve>
    </suppress>

    <!-- ===================================================================
         CPE/package false positives verified against the affected upstream
         products on 2026-08-17. Each suppression is constrained by Maven
         package URL and either the one misapplied CVE or the one erroneous
         CPE. Genuine advisories for these Java artifacts remain gating.
         ==================================================================== -->

    <suppress>
        <notes><![CDATA[
            CVE-2021-4277 affects fredsmith/utils screenshot_sync. OWASP
            Dependency-Check assigns its generic utils_project:utils CPE to
            the unrelated org.latencyutils:LatencyUtils Java histogram library.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.latencyutils/LatencyUtils@.*$</packageUrl>
        <cve>CVE-2021-4277</cve>
    </suppress>

    <suppress>
        <notes><![CDATA[
            CVE-2025-7962 is an SMTP command-injection issue in Jakarta Mail /
            Angus SMTP. org.eclipse.angus:angus-activation is the Jakarta
            Activation implementation and contains no SMTP transport.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.eclipse\.angus/angus-activation@.*$</packageUrl>
        <cve>CVE-2025-7962</cve>
    </suppress>

    <suppress>
        <notes><![CDATA[
            flyway-database-postgresql is Flyway's Java database adapter, not
            the PostgreSQL server. Its coincidental version 11.20.3 caused the
            postgresql:postgresql CPE to attach server CVEs to the adapter.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.flywaydb/flyway-database-postgresql@.*$</packageUrl>
        <cpe>cpe:/a:postgresql:postgresql</cpe>
    </suppress>

    <suppress>
        <notes><![CDATA[
            CVE-2026-33186 affects the Go module google.golang.org/grpc and its
            Go server path authorization. These are io.grpc Java artifacts;
            they do not contain the vulnerable grpc-go implementation.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/io\.grpc/grpc-(api|context|core|netty-shaded|protobuf|protobuf-lite|services|stub|util)@.*$</packageUrl>
        <cve>CVE-2026-33186</cve>
    </suppress>

    <suppress>
        <notes><![CDATA[
            CVE-2026-42154 affects the Go Prometheus server's /api/v1/read
            endpoint. The io.prometheus:simpleclient Java metrics libraries
            neither implement nor expose that Prometheus server endpoint.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/io\.prometheus/simpleclient(_.*)?@.*$</packageUrl>
        <cve>CVE-2026-42154</cve>
    </suppress>

    <suppress>
        <notes><![CDATA[
            CVE-2022-40152 affects the Woodstox parser implementation before
            the patched releases. org.codehaus.woodstox:stax2-api is only the
            API contract; Chronicle resolves woodstox-core 7.2.0 separately.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.codehaus\.woodstox/stax2-api@.*$</packageUrl>
        <cve>CVE-2022-40152</cve>
    </suppress>
</suppressions>

# Caddy with the rate-limit plugin.
#
# Caddy has no built-in rate limiter, and this stack is internet-facing on the mobile
# ingest paths, so the limiter is compiled in here rather than bolted on at another hop.
# The hardened reference deployment gets the equivalent from Traefik middleware (5 req/s mobile,
# 20 req/s web); this bundle has no Traefik, so it does it in the one proxy it has.
#
# Pinned by digest and version so a rebuild cannot silently pull a different plugin.

FROM caddy:2.11.4-builder-alpine@sha256:2b9f32cbba6045e79212bb253f595588d20be8f7d1edf61582c519e124e0d2d8 AS builder

# Go dependencies raised past the versions Caddy 2.11.4 pins, for fixed HIGH advisories
# (trivy gate in scripts/publish-images.sh). Drop each once Caddy's go.mod reaches it.
RUN xcaddy build v2.11.4 \
    --with github.com/mholt/caddy-ratelimit@v0.1.0 \
    --replace golang.org/x/crypto=golang.org/x/crypto@v0.55.0 \
    --replace golang.org/x/net=golang.org/x/net@v0.56.0 \
    --replace golang.org/x/text=golang.org/x/text@v0.39.0 \
    --replace google.golang.org/grpc=google.golang.org/grpc@v1.83.2

FROM caddy:2.11.4-alpine@sha256:6aeddd44c3078b0f9a35206472a11420648a79c184603ef95957d0a20044cb2b

COPY --from=builder /usr/bin/caddy /usr/bin/caddy

# qrencode is for the local-https mode only: the participant's phone has to install this
# stack's own CA before it will talk to it, and a LAN URL is error-prone to type into a
# phone by hand. The ca-export service renders the download URL as
# a QR code in the logs. ~60 KB, and nothing else in the image depends on it.
# apk upgrade picks up Alpine security fixes published after the base digest was cut.
RUN apk upgrade --no-cache && apk add --no-cache libqrencode-tools

SHELL ["/bin/ash", "-o", "pipefail", "-c"]
# Fail the build rather than the deployment if the plugin did not make it in.
RUN caddy list-modules | grep -q '^http.handlers.rate_limit$' \
    || (echo "FATAL: rate_limit module missing from build" >&2; exit 1)

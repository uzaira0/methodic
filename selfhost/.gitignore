# Real secrets and certificates live here at deploy time. Never commit them.
.env
tls/*.pem
tls/*.key
tls/*.crt
tls/*.p12

# Local backup output (overlays/backups.yml writes here).
backups/

# tls/internal-*.pem are generated by the cert-init service on first start; the *.pem rule
# above already covers them.
.env.backup.*

# The rest of what the bundle writes into its own directory at run time. Operators who
# deploy from a source checkout otherwise get a permanently dirty `git status`, which
# teaches them to stop reading it, and a `git add -A` commits operational state.
#
# .chronicle-secret-rotation is the one that matters most: rotate-secret.sh keeps the
# in-flight transaction there, including the saved pre-rotation configuration, so it can
# hold the OLD secrets for the duration of a rotation. It must never reach a commit.
.chronicle-secret-rotation/
.chronicle-restore.lock/
.chronicle-upgrade.lock/
operator-receipts/
upgrade-receipts/

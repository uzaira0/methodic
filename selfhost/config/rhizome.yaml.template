# Rendered by ../backend-entrypoint.sh at container start.
#
# Differs from the hardened reference template in one way that matters: the JDBC URL uses
# sslmode=prefer instead of verify-full + a CA certificate. The self-host Postgres
# runs on an internal Docker network with no externally-issued certificate, so
# verify-full would fail closed at boot. Traffic to it never leaves the host.
enable-persistence: false
session-clustering-enabled: false

hazelcast:
  server: true
  group: "chronicle-selfhost"
  password: "${HAZELCAST_SERVER_PASSWORD}"
  cp-member-count: 0
  seed-nodes:
    - "localhost"
  port: 5710

hazelcast-clients:
  IDS:
    server: false
    group: "chronicle-selfhost"
    password: "${HAZELCAST_CLIENT_PASSWORD}"
    cp-member-count: 0
    seed-nodes:
      - "127.0.0.1:5710"

postgres:
  citus: false
  hikari:
    jdbcUrl: "jdbc:postgresql://${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=prefer"
    username: "${POSTGRES_USER}"
    password: "${POSTGRES_PASSWORD}"
    maximumPoolSize: 20
    minimumIdle: 5
    connectionTimeout: 30000
    idleTimeout: 600000
    maxLifetime: 1800000
    leakDetectionThreshold: 300000

datasources:
  chronicle:
    citus: false
    initialize-tables: true
    hikari:
      jdbcUrl: "jdbc:postgresql://${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=prefer"
      username: "${POSTGRES_USER}"
      password: "${POSTGRES_PASSWORD}"
      maximumPoolSize: 20
      minimumIdle: 5
      connectionTimeout: 30000
      idleTimeout: 600000
      maxLifetime: 1800000
      leakDetectionThreshold: 300000

# EXPERIMENTAL Chronicle public dashboard — this stack terminates TLS with YOUR certificate.
#
# Excluded from release bundles. Put your institutional certificate in ./tls:
#   ./tls/cert.pem   (full chain: leaf + intermediates)
#   ./tls/key.pem    (private key)
#
# Pair only with mode-own-tls-public.yml and the reviewed authentication overlay here.
#
# The routes are imported from snippets.caddy, so they are identical to the plain-HTTP
# Caddyfile by construction.
#
# If your certificate comes from a PRIVATE/internal CA, the mobile apps must be told to
# trust that CA — see docs/CONFIGURATION.md → "Mobile apps and TLS trust". A publicly
# trusted certificate needs no device-side change.
#
# For a public host that should use free Let's Encrypt certificates instead, replace the
# `import chronicle_tls` line below with `tls {$ACME_EMAIL}` and delete `auto_https off`.
{
	# No ACME. The certificate is the one you mounted, full stop.
	auto_https off

	# rate_limit ships as a plugin (see Dockerfile.caddy), so its place in the handler
	# chain has to be declared explicitly.
	order rate_limit before basic_auth

	servers {
		trusted_proxies static private_ranges
	}
}

import snippets.caddy

https://{$DOMAIN} {
	import chronicle_tls
	import chronicle_common

	route {
		import chronicle_health
		import chronicle_deny_direct
		import chronicle_mobile
		import chronicle_dashboard_api
		import chronicle_spa
	}
}

# Plain HTTP redirects to HTTPS. `auto_https off` disables Caddy's built-in redirect, so
# it is written out explicitly here.
http://{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

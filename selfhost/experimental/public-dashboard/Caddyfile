# Chronicle self-host — single entry point, plain HTTP.
#
# One Caddy container serves the dashboard's static files AND routes the API. There is no
# second proxy and no separate static-file server.
#
# EXPERIMENTAL public-dashboard listener, excluded from release bundles. The supported
# institutional mode is Caddyfile.split, which keeps researcher routes on a private listener.
#
# The TLS equivalent is Caddyfile.tls in this directory.
{
	# The stack either sits behind your TLS terminator or uses certificate files you
	# provide. ACME is never attempted implicitly.
	auto_https off

	# rate_limit ships as a plugin (see Dockerfile.caddy), so its place in the handler
	# chain has to be declared explicitly.
	order rate_limit before basic_auth

	servers {
		# Honor X-Forwarded-Proto/For from an upstream institutional proxy on a private
		# network, so the backend sees the real client scheme and IP. Without this Caddy
		# overwrites them with the hop it saw.
		trusted_proxies static private_ranges
	}
}

import snippets.caddy

:80 {
	import chronicle_common

	# `route` preserves the literal order below. Without it Caddy reorders directives by
	# its own specificity rules, which makes the path precedence harder to reason about.
	route {
		import chronicle_health
		import chronicle_deny_direct
		import chronicle_mobile
		import chronicle_dashboard_api
		import chronicle_spa
	}
}

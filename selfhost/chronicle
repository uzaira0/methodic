    die "source images require a git checkout so their inputs can be identified"

  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    status="${line:0:1}"
    case "$status" in
      ' ') ;;
      -) die "a required source submodule is not initialized. Run: git submodule update --init --recursive" ;;
      +) die "a source submodule does not match this checkout. Preserve any local work, then run: git submodule update --init --recursive" ;;
      U) die "a source submodule has an unresolved merge conflict" ;;
      *) die "could not verify the source submodule state" ;;
    esac
  done < <(git -C .. submodule status --recursive -- "${SOURCE_SUBMODULES[@]}")

  # A commit-derived image tag is truthful only when every copied build input matches that
  # commit. Runtime state and .env are ignored by git and never enter the Docker context.
  if ! git -C .. diff --quiet --no-ext-diff HEAD -- \
      build.gradle.kts settings.gradle.kts gradle.properties gradle gradles gradlew \
      docker selfhost; then
    die "tracked source-image inputs have local changes. Commit them on an appropriate branch or restore them before building a deployable source image"
  fi
  if [[ -n "$(git -C .. ls-files --others --exclude-standard -- \
      build.gradle.kts settings.gradle.kts gradle.properties gradle gradles gradlew \
      docker selfhost)" ]]; then
    die "untracked source-image inputs are present. Review and commit or remove them before building a deployable source image"
  fi
  for module in "${SOURCE_SUBMODULES[@]}"; do
    git -C "../$module" diff --quiet --no-ext-diff &&
      git -C "../$module" diff --cached --quiet --no-ext-diff &&
      [[ -z "$(git -C "../$module" ls-files --others --exclude-standard)" ]] ||
      die "source submodule $module has local or untracked changes; refusing to label them as a published revision"
  done

  revision="$(git -C .. rev-parse --verify HEAD)"
  [[ "$revision" =~ ^[0-9a-f]{40}$ ]] || die "could not resolve the source revision"
  printf '%s\n' "$revision"
}

is_managed_source_image() {
  local value="$1" component="$2"
  [[ "$value" == "${SOURCE_TAG_PREFIX}-${component}:source" ||
     "$value" =~ ^${SOURCE_TAG_PREFIX}-${component}:source-[0-9a-f]{16}$ ]]
}

# Build one image if it is not already present. Never rebuilds a tag that exists -- an
# operator who wants a rebuild has ./chronicle upgrade, and silently rebuilding on every
# `up` would turn a restart into a ten-minute wait.
build_image_if_missing() {
  local tag="$1" dockerfile="$2" context="$3" label="$4" build_argument="${5:-}"
  local -a build_options=(-q -f "$dockerfile" -t "$tag")
  if docker image inspect "$tag" >/dev/null 2>&1; then
    ok "$label image present ($tag)"
    return 0
  fi
  [[ -z "$build_argument" ]] || build_options+=(--build-arg "$build_argument")
  printf '  building %s from %s for this source revision\n' "$label" "$dockerfile"
  docker build "${build_options[@]}" "$context" >/dev/null ||
    die "could not build the $label image from $dockerfile"
  ok "$label image built ($tag)"
}

# Only tags owned by this source checkout may be populated from local source. A custom
# registry tag is an operator instruction to pull/use that image; building the checkout
# under the same name would silently substitute different code.
build_managed_source_image_if_missing() {
  local tag="$1" component="$2"
  shift 2
  is_managed_source_image "$tag" "$component" || return 0
  build_image_if_missing "$tag" "$@"
}

# Resolve the three image variables before compose ever sees them.
ensure_images() {
  local build_backend=0 build_frontend=0 build_caddy=0
  if [[ "${BACKEND_IMAGE:-}" == *__CHRONICLE_* ]] ||
      is_managed_source_image "${BACKEND_IMAGE:-}" backend; then
    build_backend=1
  fi
  if [[ "${SELFHOST_FRONTEND_IMAGE:-}" == *__CHRONICLE_* ]] ||
      is_managed_source_image "${SELFHOST_FRONTEND_IMAGE:-}" frontend; then
    build_frontend=1
  fi
  if [[ "${CADDY_IMAGE:-}" == *__CHRONICLE_* ]] ||
      is_managed_source_image "${CADDY_IMAGE:-}" caddy; then
    build_caddy=1
  fi

  # All three are release digests or custom operator references. Leave resolution and
  # pulling to Compose; source-checkout cleanliness is irrelevant when nothing is built.
  ((build_backend || build_frontend || build_caddy)) || return 0

  if ! is_source_checkout; then
    die "one or more image values request a source build, but this is not a source checkout.
       Use a published release bundle, or set all three variables to images you have."
  fi

  printf '\n%sImages%s\n' "$BLD" "$RST"
  ensure_sources
  local backend_tag frontend_tag caddy_tag source_revision
  source_revision="$(source_checkout_revision)" || exit 1
  backend_tag="$(source_image_tag backend "$source_revision")"
  frontend_tag="$(source_image_tag frontend "$source_revision")"
  caddy_tag="$(source_image_tag caddy "$source_revision")"

  # Claim placeholders and tags previously managed by this source checkout. An operator
  # who supplied a custom image keeps it. Legacy unversioned :source tags are upgraded
  # once; revisioned tags change after git pull and therefore cannot conceal stale code.
  if ((build_backend)); then
    BACKEND_IMAGE="$backend_tag"
  fi
  if ((build_frontend)); then
    SELFHOST_FRONTEND_IMAGE="$frontend_tag"
  fi
  if ((build_caddy)); then
    CADDY_IMAGE="$caddy_tag"
  fi

  build_managed_source_image_if_missing "$BACKEND_IMAGE" backend \
    ../docker/Dockerfile.backend .. backend "VCS_REF=$source_revision"
  build_managed_source_image_if_missing "$SELFHOST_FRONTEND_IMAGE" frontend \
    Dockerfile.frontend .. frontend "GIT_SHA=$source_revision"
  build_managed_source_image_if_missing "$CADDY_IMAGE" caddy \
    Dockerfile.caddy . proxy

  # Persist so `check`, `status`, `verify` and a plain `docker compose` all agree with what
  # `up` just built, instead of the resolution living only in this process.
  if ! python3 - "$BACKEND_IMAGE" "$SELFHOST_FRONTEND_IMAGE" "$CADDY_IMAGE" <<'PY'
from pathlib import Path
import os
import re
import sys

path = Path(".env")
values = dict(zip(
    ("BACKEND_IMAGE", "SELFHOST_FRONTEND_IMAGE", "CADDY_IMAGE"),
    sys.argv[1:],
))
content = path.read_text(encoding="utf-8")
for key, value in values.items():
    pattern = re.compile(rf"^{key}=.*$", re.MULTILINE)
    if not pattern.search(content):
        raise SystemExit(f"{key} is missing from .env")
    content = pattern.sub(f"{key}={value}", content, count=1)
temporary = path.with_name(f".{path.name}.images-{os.getpid()}")
try:
    with temporary.open("x", encoding="utf-8") as handle:
        handle.write(content)
        handle.flush()
        os.fsync(handle.fileno())
    temporary.chmod(0o600)
    os.replace(temporary, path)
    directory_fd = os.open(path.parent, os.O_RDONLY)
    try:
        os.fsync(directory_fd)
    finally:
        os.close(directory_fd)
finally:
    temporary.unlink(missing_ok=True)
PY
  then
    die "could not atomically record the source image revisions in .env"
  fi
  export BACKEND_IMAGE SELFHOST_FRONTEND_IMAGE CADDY_IMAGE
}

# ---------------------------------------------------------------------------------- up
# Start the configured services after host checks, then run the trial CA export separately.
assert_no_incomplete_mutation() {
  ops_python reconcile "${2:-check}" || die "cannot ${1:-start Chronicle}; follow the operation recovery runbook"
}

lock_operation() {
  local path
  path=$(ops_python reconcile lock-path) || die "could not resolve the operation lock"
  if [[ "${CHRONICLE_OPERATION_LOCK_FD:-}" =~ ^[0-9]+$ ]] &&
      [[ "$path" -ef "/dev/fd/$CHRONICLE_OPERATION_LOCK_FD" ]]; then
    return
  fi
  # Lock in place rather than re-running the command under the lock: a re-run replays setup's
  # prompts against stdin it already consumed. flock belongs to the open file, so the lock the
  # helper takes through fd 9 stays held by this shell. Fixed fd: macOS bash 3.2 has no {fd}.
  [[ ! -L "$path" ]] || die "operation lock $path is a symlink"
  exec 9<>"$path" || die "could not open the operation lock $path"
  export CHRONICLE_OPERATION_LOCK_FD=9
  ops_python -c 'import sys; from chronicle_ops.common import acquire_operation_lock; sys.exit(acquire_operation_lock(sys.argv[1]) is not None)' \
    "$STATE_ROOT" || die "could not acquire the operation lock"
}

cmd_up() {
  shift || true
  need_env
  if [[ "${1:-}" == --no-reconcile ]]; then
    export CHRONICLE_RECONCILE_ENABLED=false
  fi
  # A destructive restore can leave a deliberately stopped, partially replaced schema.
  # The preserved lock must be an enforced interlock, not merely a warning printed by the
  # failed restore process. Apply the same rule to failed upgrades and rotations: `up` is
  # the ordinary recovery shortcut operators will reach for after a failure, so it must not
  # bypass the state-changing command's fail-closed boundary (including dangling symlinks).
  begin_operation up startup_failed
  local locked_state="$STATE_ROOT" locked_project="$PROJECT"
  lock_operation
  need_env
  [[ "$STATE_ROOT" == "$locked_state" && "$PROJECT" == "$locked_project" ]] ||
    die "state directory or Compose project changed while acquiring the lock; retry startup"
  ops_python owner-check || die "startup must run from the active selfhost directory"
  if [[ "${CHRONICLE_RECONCILE_RUN:-false}" == true ]] && ops_python reconcile stopped; then return 0; fi
  assert_no_incomplete_mutation "start Chronicle" check-start
  local dashboard_login_migrated
  dashboard_login_migrated=$(ops_python dashboard-login-migrate) || die "dashboard password migration failed"
  need_env
  ensure_images
  preflight
  local certificate_applied certificate_after certificate_marker="$STATE_ROOT/tls/.applied-certificates"
  certificate_applied=$(cat "$certificate_marker" 2>/dev/null || true)
  dc run --rm --no-deps cert-init || die "certificate preparation failed"
  certificate_after=$(find "$STATE_ROOT/tls" -type f \( -name '*cert.pem' -o -name '*.crt' -o -name '*.sha256' \) -exec sha256sum {} + 2>/dev/null | sort)
  printf '%sStarting%s (%s)\n' "$BLD" "$RST" "${COMPOSE_FILE:-docker-compose.yml}"
  printf '  on a first run this also initialises the database — no output until it settles\n\n'
  # Compose's own progress stream prints one line per container per state transition: 34
  # lines for this stack, ten of them for the single config-guard that starts and exits.
  # It scrolls the preflight results off the screen and contains nothing an operator can
  # act on. The service table below is the same information, once, in its final form.
  # ca-export exits after it writes the local CA. Run it after the long-running services are
  # healthy, because Compose --wait treats an exited one-shot service as a startup failure.
  local configured_services service has_ca_export=false
  local -a startup_services=() startup_options=()
  if [[ "$certificate_applied" != "$certificate_after" || "$dashboard_login_migrated" == changed ]]; then
    startup_options+=(--force-recreate)
  elif [[ "${CHRONICLE_RECONCILE_RUN:-false}" == true ]]; then
    startup_options+=(--no-recreate)
  fi
  if ! configured_services="$(dc config --services)"; then
    die "could not resolve the Compose service list"
  fi
  while IFS= read -r service; do
    [[ -n "$service" ]] || continue
    if [[ "$service" == ca-export ]]; then
      has_ca_export=true
    else
      startup_services+=("$service")
    fi
  done <<<"$configured_services"
  ((${#startup_services[@]} > 0)) || die "Compose has no long-running services to start"
  dc --progress quiet up -d --wait --wait-timeout "${START_WAIT_TIMEOUT_SECONDS:-3600}" --remove-orphans "${startup_options[@]}" "${startup_services[@]}" ||
    die "startup failed — see ./chronicle logs"
  if [[ "$has_ca_export" == true ]]; then
    dc run --rm --no-deps ca-export || die "local trial CA export failed; review the CA export error above"
  fi
  ops_python public-check || die "public HTTPS acceptance failed; verify the LB route, DNS and certificate"
  printf '%s\n' "$certificate_after" | ops_python -c 'import sys; from chronicle_ops.receipts import write_text; write_text(sys.argv[1], sys.stdin.read().rstrip("\n"))' \
    "$certificate_marker" || die "could not record the certificates applied at startup"
  dc ps --format '{{.Service}}\t{{.Status}}' 2>/dev/null | sort | sed 's/^/  /'
  printf '\n%sStarted.%s Next: ./chronicle verify\n' "$GRN" "$RST"
  if [[ "${CHRONICLE_RECONCILE_RUN:-false}" != true && "${CHRONICLE_RECONCILE_ENABLED:-true}" == true ]]; then
    ops_python reconcile resume || die "could not resume periodic reconciliation"
  fi
  operation_succeeded
}

# ------------------------------------------------------------------------------ verify
# Proves the boundary from outside the stack rather than trusting the config.
cmd_verify() {
  ops_require_python
  need_env
  shift || true
  ops_python verify "$@"
}

# Validates .env and the bundle without building or starting anything.
cmd_check() {
  shift || true
  need_env
  begin_operation check configuration_invalid
  preflight
  printf '%sConfiguration is valid.%s  Next: ./chronicle up\n' "$GRN" "$RST"
  operation_succeeded
}

cmd_status() {
  shift || true
  need_env
  begin_operation status status_failed
  dc ps || die "could not inspect Compose service status"
  operation_succeeded
}
cmd_logs()   { need_env; shift || true; dc logs -f --tail=100 "$@"; }
cmd_down() {
  shift || true
  [[ $# -eq 0 ]] || die "usage: ./chronicle down (takes no arguments)"
  need_env
  begin_operation down shutdown_failed
  lock_operation
  ops_python owner-check || die "shutdown must run from the active selfhost directory"
  ops_python reconcile stop || die "could not pause periodic reconciliation before shutdown"
  dc down --remove-orphans || die "Compose shutdown failed"
  operation_succeeded
}

doctor_add() { # id status summary action
  DOCTOR_ROWS+=("$1"$'\x1f'"$2"$'\x1f'"$3"$'\x1f'"$4")
  [[ "$2" == fail ]] && DOCTOR_FAILED=1
}

cmd_doctor() {
  shift || true
  local json=false
  if (($#)); then
    [[ "$#" -eq 1 && "$1" == --json ]] || die "usage: ./chronicle doctor [--json]"
    json=true
  fi
  need_env
  begin_operation doctor diagnosis_failed
  local -a DOCTOR_ROWS=()
  local disk_warn_free_percent=15
  local DOCTOR_FAILED=0 running="" free_kb=0 free_gib=0 free_pct=0

  if ops_python reconcile stopped; then
    doctor_add reconciliation warn "Periodic reconciliation is paused" "Run ./chronicle up from the active release to resume"
  fi
  if ! ops_python reconcile check >/dev/null 2>&1; then
    doctor_add operation-lock warn "An incomplete operation is preserved" "Follow the recorded recovery owner's restore, upgrade or rotation runbook"
  fi

  if docker info >/dev/null 2>&1; then
    doctor_add docker ok "Docker daemon is reachable" "none"
  else
    doctor_add docker fail "Docker daemon is unreachable" "Start Docker, then rerun ./chronicle doctor"
  fi

  if dc config --quiet >/dev/null 2>&1; then
    doctor_add compose ok "Compose configuration renders" "none"
  else
    doctor_add compose fail "Compose configuration does not render" "Run docker compose config and correct the reported .env or YAML error"
  fi

  if ops_python public-check >/dev/null 2>&1; then
    doctor_add public-readiness ok "Public HTTPS has dependency-aware readiness" "none"
  else
    doctor_add public-readiness fail "Public HTTPS is unavailable or unready" "Inspect DNS, TLS and LB pool routing"
  fi

  running="$(dc ps --status running --services 2>/dev/null || true)"
  local service
  for service in postgres backend web; do
    local health
    health=$(dc ps -q "$service" | xargs -r docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' 2>/dev/null)
    if [[ "$health" == healthy ]]; then
      doctor_add "service-${service}" ok "${service} is healthy" "none"
    else
      doctor_add "service-${service}" fail "${service} is not running" "Run ./chronicle logs ${service}, correct the first error, then run ./chronicle up"
    fi
  done

  if ops_python database-privileges >/dev/null 2>&1; then
    doctor_add database-privileges ok "Database runtime roles retain audit and restore privilege restrictions" "none"
  else
    doctor_add database-privileges fail "Database audit/restore privileges could not be verified" "Recover a reviewed backup that preserves ACLs"
  fi

  if [[ "${CHRONICLE_REVIEWER_ACCESS_ENABLED:-false}" == true ||
        -n "${CHRONICLE_REVIEWER_STUDY_ID:-}" ||
        -n "${CHRONICLE_REVIEWER_PARTICIPANT_ID:-}" ]]; then
    local reviewer_state="query-failed"
    if [[ "${CHRONICLE_REVIEWER_STUDY_ID:-}" =~ ^[0-9A-Fa-f-]{36}$ &&
          "${CHRONICLE_REVIEWER_PARTICIPANT_ID:-}" =~ ^[a-zA-Z0-9_.-]{1,255}$ ]] &&
       grep -Fxq postgres <<<"$running"; then
      reviewer_state="$(reviewer_scope_state \
        "$CHRONICLE_REVIEWER_STUDY_ID" "$CHRONICLE_REVIEWER_PARTICIPANT_ID" 2>/dev/null || true)"
    fi
    if [[ "$reviewer_state" == ok ]]; then
      doctor_add reviewer-scope ok \
        "Play reviewer study and synthetic participant are active" "none"
    else
      doctor_add reviewer-scope fail \
        "Play reviewer scope is unavailable (${reviewer_state:-query-failed})" \
        "Use the dashboard to create/activate the synthetic reviewer study and participant, then rerun ./chronicle doctor"
    fi
  else
    doctor_add reviewer-scope warn "Play reviewer bootstrap is not configured" \
      "Follow the Play reviewer setup in README.md before submitting the app for review"
  fi

  if ! read -r free_kb free_pct < <(
    df -Pk "$STATE_ROOT" 2>/dev/null |
      awk 'NR==2 {gsub(/%/,"",$5); print $4, 100-$5}' || true
  ); then
    # Preserve doctor's structured failure row when df is unavailable or malformed. With
    # `set -e`, an unguarded read exits the command before the branch below can explain it.
    free_kb=""
    free_pct=""
  fi
  if [[ "$free_kb" =~ ^[0-9]+$ && "$free_pct" =~ ^[0-9]+$ ]]; then
    free_gib=$(( free_kb / 1048576 ))
  fi
  if [[ "$free_pct" =~ ^[0-9]+$ ]] && (( free_pct >= disk_warn_free_percent )); then
    doctor_add disk ok "Host filesystem has ${free_pct}% free (${free_gib} GiB)" "none"
  elif [[ "$free_kb" =~ ^[0-9]+$ && "$free_pct" =~ ^[0-9]+$ ]] && (( free_kb >= 20971520 )); then
    doctor_add disk warn \
      "Host filesystem is ${free_pct}% free but retains ${free_gib} GiB" \
      "Plan more capacity before free space falls below 20 GiB"
  elif [[ "$free_pct" =~ ^[0-9]+$ ]]; then
    doctor_add disk fail \
      "Host filesystem has only ${free_pct}% free (${free_gib} GiB)" \
      "Free or add disk space before restarting or exporting data"
  else
    doctor_add disk fail "Host filesystem capacity could not be read" "Run df -h and verify the Chronicle state filesystem"
  fi

  if [[ "${COMPOSE_FILE:-}" == *overlays/backups.yml* ]]; then
    if ! ops_python backup-storage >/dev/null 2>&1; then
      doctor_add backup-encryption warn "Backup backing-device encryption is unconfirmed" \
        "Enable storage encryption or record a reviewed BACKUP_STORAGE_ENCRYPTION_WAIVER"
    fi
    if ops_python - >/dev/null 2>&1 <<'PY_BACKUP'
from chronicle_ops.verify import verify_backup
from chronicle_ops.release import read_env, value
import os
raise SystemExit(verify_backup(os.environ['CHRONICLE_OPS_BACKUPS'], value(read_env('.env'), 'POSTGRES_DB', 'chronicle')))
PY_BACKUP
    then
      doctor_add backup ok "Active database has a fresh restore-verified backup" "none"
    else
      doctor_add backup fail "Active database has no fresh verified backup" "Inspect db-backup logs and available scratch capacity"
    fi
  fi
  while IFS=$'\x1f' read -r ident outcome summary action; do
      doctor_add "$ident" "$outcome" "$summary" "$action"
    done < <(ops_python - <<'PY_CAPACITY'
from chronicle_ops.verify import capacity_checks
from chronicle_ops.release import read_env
import os
try:
    rows = capacity_checks(read_env('.env'), os.environ['CHRONICLE_OPS_BACKUPS'])
except Exception:
    rows = [('backup-capacity', 'fail', 'Could not measure database/backup/WAL capacity', 'Inspect PostgreSQL and backing filesystems')]
for row in rows:
    print('\x1f'.join(row))
PY_CAPACITY
)

  if [[ "${COMPOSE_FILE:-}" == *overlays/monitoring.yml* ]]; then
    local monitor_service
    for monitor_service in victoriametrics victorialogs fluent-bit grafana operational-probe; do
      if grep -Fxq "$monitor_service" <<<"$running"; then
        doctor_add "monitor-${monitor_service}" ok "${monitor_service} is running" "none"
      else
        doctor_add "monitor-${monitor_service}" fail "${monitor_service} is not running" "Run ./chronicle logs ${monitor_service}, correct the first error, then docker compose up -d ${monitor_service}"
      fi
    done
    while IFS=$'\x1f' read -r ident outcome summary action; do
      doctor_add "$ident" "$outcome" "$summary" "$action"
    done < <(ops_python - <<'PY_MONITORING'
from chronicle_ops.verify import monitoring_checks
try:
    rows = monitoring_checks()
except Exception:
    rows = [('monitoring-pipeline', 'fail', 'Could not qualify metrics/log delivery', 'Inspect monitoring service logs')]
for row in rows:
    print('\x1f'.join(row))
PY_MONITORING
)
    if [[ -n "${CHRONICLE_ALERT_WEBHOOK_URL:-}" ]]; then
      doctor_add alert-route ok "A human alert destination is configured" "none"
    else
      doctor_add alert-route warn "Alerts remain visible in Grafana only; no human destination is configured" \
        "Set CHRONICLE_ALERT_WEBHOOK_URL in .env, apply it with docker compose up -d grafana, then test the contact point in Grafana"
    fi
  else
    doctor_add monitoring warn "Monitoring overlay is disabled" "Run ./chronicle setup to enable it, or add overlays/monitoring.yml as documented"
  fi

  if [[ "$json" == true ]]; then
    printf '%s\0' "${DOCTOR_ROWS[@]}" | DOCTOR_FAILED="$DOCTOR_FAILED" python3 -c '
import json, os, sys
rows=[]
for raw in sys.stdin.buffer.read().split(b"\0"):
    if not raw: continue
    ident,status,summary,action=raw.decode().split("\x1f")
    rows.append({
        "check": ident,
        "status": status,
        "likelyCause": summary,
        "recoveryCommand": action,
    })
print(json.dumps({"overall":"fail" if os.environ["DOCTOR_FAILED"]=="1" else "ok","checks":rows}, separators=(",",":")))
'
  else
    printf '%sChronicle doctor%s\n' "$BLD" "$RST"
    local row id status summary action
    for row in "${DOCTOR_ROWS[@]}"; do
      IFS=$'\x1f' read -r id status summary action <<<"$row"
      case "$status" in
        ok) printf '  %sok%s   %-26s %s\n' "$GRN" "$RST" "$id" "$summary" ;;
        warn) printf '  %swarn%s %-26s %s\n       action: %s\n' "$YEL" "$RST" "$id" "$summary" "$action" ;;
        fail) printf '  %sFAIL%s %-26s %s\n       action: %s\n' "$RED" "$RST" "$id" "$summary" "$action" ;;
      esac
    done
  fi
  if [[ $DOCTOR_FAILED -eq 0 ]]; then
    operation_succeeded
    return 0
  fi
  return 1
}


require_monitoring() {
  source "$(dirname "$SCRIPT_PATH")/network-policy.sh"
  [[ "${COMPOSE_FILE:-}" == *overlays/monitoring.yml* ]] ||
    die "monitoring is disabled; rerun ./chronicle setup and enable the monitoring overlay"
}

read_viewer_password() {
  local first second
  if [[ -t 0 ]]; then
    read -rsp 'Viewer password (16+ characters): ' first; printf '\n'
    read -rsp 'Confirm viewer password: ' second; printf '\n'
  else
    IFS= read -r first || die "expected viewer password on stdin"
    IFS= read -r second || die "expected password confirmation on stdin"
  fi
  [[ "$first" == "$second" ]] || die "viewer passwords do not match"
  [[ ${#first} -ge 16 ]] || die "viewer password must be at least 16 characters"
  VIEWER_PASSWORD="$first"
}

cmd_monitoring() {
  shift || true
  [[ $# -ge 1 ]] || die "usage: ./chronicle monitoring status|add-viewer|remove-viewer|reset-viewer [name]"
  local action="$1" name="${2:-}" base
  need_env
  require_monitoring
  begin_operation "monitoring-${action}" monitoring_failed
  base="$(grafana_base_url)"
  case "$action" in
    status)
      [[ $# -eq 1 ]] || die "usage: ./chronicle monitoring status"
      printf '%sPrivate monitoring%s (%s)\n' "$BLD" "$RST" "$base"
      dc ps monitoring-config cadvisor operational-probe metrics-exporter victoriametrics victorialogs fluent-bit grafana ||
        die "could not inspect monitoring service status"
      if curl --noproxy '*' -fsS --max-time 8 --cacert "$STATE_ROOT/tls/monitoring.crt" "$base/api/health" >/dev/null 2>&1; then
        printf '  %sok%s   Grafana answers on the configured private listener\n' "$GRN" "$RST"
      else
        die "Grafana is not reachable at $base; run ./chronicle doctor"
      fi
      ;;
    add-viewer|remove-viewer|reset-viewer)
      [[ $# -eq 2 ]] || die "usage: ./chronicle monitoring ${action} NAME"
      [[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$ ]] || die "viewer name must use 1..64 letters, numbers, dot, underscore, or dash"
      [[ "$name" != admin ]] || die "the Grafana admin account cannot be managed as a viewer"
      local operation="${action%-viewer}" password=""
      if [[ "$action" != remove-viewer ]]; then
        VIEWER_PASSWORD=""
        read_viewer_password
        password="$VIEWER_PASSWORD"
      fi
      if ! printf '%s\0' "$base" "${GRAFANA_ADMIN_PASSWORD:?GRAFANA_ADMIN_PASSWORD is not set}" \
        "$operation" "$name" "$password" | GRAFANA_CA_FILE="$STATE_ROOT/tls/monitoring.crt" python3 ./monitoring/grafana-user.py; then
        VIEWER_PASSWORD=""; password=""
        die "Grafana viewer operation failed"
      fi
      VIEWER_PASSWORD=""; password=""
      ;;
    *) die "usage: ./chronicle monitoring status|add-viewer|remove-viewer|reset-viewer [name]" ;;
  esac
  operation_succeeded
}

ops_require_python() {
  command -v python3 >/dev/null 2>&1 || die "required command is unavailable: python3"
  python3 -c 'import sys; sys.exit(sys.version_info < (3, 9))' ||
    die "python3 3.9 or newer is required"
}

ops_python() {
  local script_dir launch=command
  script_dir="$(dirname "$SCRIPT_PATH")"
  export CHRONICLE_OPS_PROJECT="${PROJECT:-chronicle-selfhost}"
  export CHRONICLE_OPS_STATE="${STATE_ROOT:-$(pwd -P)}"
  export CHRONICLE_OPS_BACKUPS="${BACKUPS_HOST_DIR:-${CHRONICLE_OPS_STATE}/backups}"
  export CHRONICLE_OPS_VERSION="${RELEASE_VERSION:-unknown}"
  export CHRONICLE_OPS_TLS_MODE="${TLS_MODE:-}" CHRONICLE_OPS_EXPOSURE="${DASHBOARD_EXPOSURE:-}"
  export COMPOSE_FILE="${COMPOSE_FILE:-}"
  # These settings were resolved by need_env; deployment secrets stay out of child environments.
  local setting
  for setting in HTTP_BIND HTTP_PORT INTERNAL_BIND INTERNAL_PORT CHRONICLE_PUBLIC_BASE_URL DOMAIN \
      ENABLE_BACKUPS ENABLE_ENCRYPTION POSTGRES_DB POSTGRES_IMAGE START_WAIT_TIMEOUT_SECONDS DASHBOARD_USER CHRONICLE_REVIEWER_ACCESS_ENABLED \
      RATE_LIMIT_MOBILE_ABUSE_EVENTS RATE_LIMIT_MOBILE_WINDOW RATE_LIMIT_RETRY_SLEEP \
      RESTORE_START_WAIT_TIMEOUT_SECONDS UPGRADE_WAIT_TIMEOUT_SECONDS MIN_FREE_DISK_GIB CHRONICLE_RECONCILE_ENABLED; do
    [[ -z "${!setting+x}" ]] || export "${setting?}"
  done
  case "$1" in restore|verify|adopt|upgrade|rollback|operation-lock) launch="exec" ;; esac
  case "$1" in -|-c) ;; *) set -- -m chronicle_ops "$@" ;; esac
  PYTHONDONTWRITEBYTECODE=1 PYTHONPATH="$script_dir" "$launch" python3 "$@"
}

cmd_restore() {
  ops_require_python
  need_env
  lock_operation
  need_env
  ops_python owner-check || die "restore must run from the active selfhost directory"
  shift || true
  ops_python restore "$@"
}

cmd_reconcile() {
  shift || true
  need_env
  lock_operation
  ops_python owner-check || die "reconciliation changes must run from the active selfhost directory"
  ops_python dashboard-login-migrate >/dev/null || die "dashboard password migration failed"
  need_env
  ops_python reconcile "$@" || die "could not change the reconciliation schedule"
}

cmd_deletion_status() {
  shift || true
  [[ $# -ge 1 && $# -le 2 ]] ||
    die "usage: ./chronicle deletion-status STUDY_UUID [OPERATION_UUID]"
  local study_id="$1" operation_id="${2:-}"
  local uuid_pattern='^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$'
  [[ "$study_id" =~ $uuid_pattern ]] || die "STUDY_UUID is not a UUID"
  [[ -z "$operation_id" || "$operation_id" =~ $uuid_pattern ]] ||
    die "OPERATION_UUID is not a UUID"
  need_env
  begin_operation deletion-status query_failed

  if ! printf '%s\n%s\n' "$study_id" "$operation_id" | dc exec -T postgres /bin/bash -euc '
    : "${POSTGRES_PASSWORD:?POSTGRES_PASSWORD is unavailable in the postgres container}"
    IFS= read -r study_id
    IFS= read -r operation_id || true
    uuid_pattern="^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
    [[ "$study_id" =~ $uuid_pattern ]]
    [[ -z "$operation_id" || "$operation_id" =~ $uuid_pattern ]]
    operation_predicate=""
    if [[ -n "$operation_id" ]]; then
      operation_predicate="AND operation.operation_id = '\''${operation_id}'\''::uuid"
    fi
    export PGPASSWORD="$POSTGRES_PASSWORD"
    exec psql -X -v ON_ERROR_STOP=1 -P pager=off \
      -h 127.0.0.1 -U "${POSTGRES_USER:-chronicle}" -d "${POSTGRES_DB:-chronicle}" <<SQL
SELECT operation.operation_id,
       operation.mode,
       operation.status,
       operation.quarantine_until,
       operation.completed_at,
       CASE
         WHEN operation.status = '\''COMPLETED'\''
          AND operation.proof_hash IS NOT NULL
          AND tombstone.proof_hash = operation.proof_hash THEN '\''verified'\''
         WHEN operation.status = '\''COMPLETED'\'' THEN '\''missing-proof'\''
         ELSE '\''pending'\''
       END AS proof_state,
       holds.review_at IS NOT NULL AS active_hold,
       holds.review_at,
       COALESCE(holds.review_at < now(), false) AS review_overdue,
       COALESCE(operation.failure_code, '\'''\'') AS failure_code
  FROM data_deletion_operations AS operation
  LEFT JOIN data_deletion_tombstones AS tombstone
    ON tombstone.operation_id = operation.operation_id
  LEFT JOIN LATERAL (
    SELECT min(hold.review_at) AS review_at
      FROM retention_holds AS hold
      JOIN data_deletion_operations AS overlap ON overlap.operation_id = hold.operation_id
     WHERE hold.released_at IS NULL
       AND overlap.study_id = operation.study_id
       AND (overlap.mode = '\''STUDY_ERASURE'\'' OR operation.mode = '\''STUDY_ERASURE'\''
            OR overlap.participant_block_token = operation.participant_block_token)
  ) AS holds ON true
 WHERE operation.study_id = '\''${study_id}'\''::uuid
   ${operation_predicate}
 ORDER BY operation.created_at DESC;
SQL
  '; then
    die "could not query deletion operation status"
  fi
  operation_succeeded
}

cmd_update() {
  shift || true
  [[ $# -eq 0 || ( $# -eq 1 && "$1" == --check ) ]] || die "usage: ./chronicle update [--check]"
  local tool
  for tool in curl python3 ssh-keygen; do
    command -v "$tool" >/dev/null 2>&1 || die "update requires missing tool: $tool"
  done
  ops_python - "$(pwd -P)" "${1:-}" \
    "${CHRONICLE_RELEASES_URL:-https://api.github.com/repos/uzaira0/methodic/releases/latest}" <<'PY'
import json
import os
from chronicle_ops.dump import file_sha256
from chronicle_ops.release import RELEASE_SIGNER, UPDATE_AVAILABLE_EXIT, free_disk_floor, parse_version, read_env, read_manifest, require_current_owner, value
from chronicle_ops.common import require_storage, UPDATE_PEAK_BYTES
from chronicle_ops.receipts import durable_replace, sync_directory
from pathlib import Path, PurePosixPath
import re
import shlex
import shutil
import signal
import subprocess
import sys
import tarfile
import tempfile
from urllib.parse import urlparse

selfhost = Path(sys.argv[1]).resolve()
check = sys.argv[2] == "--check"
staging = None


def fail(message):
    raise ValueError(message)


def version_key(version):
    if not isinstance(version, str):
        fail("missing release_version or release tag")
    return parse_version(version.removeprefix("v"), "release metadata")


# Bound every download and the archive inventory before anything is parsed or extracted.
MAX_METADATA_BYTES = 1024 * 1024
MAX_ARCHIVE_BYTES = 512 * 1024 * 1024
MAX_ARCHIVE_MEMBERS = 20000
MAX_UNPACKED_BYTES = 2 * 1024 * 1024 * 1024


def curl(url, output=subprocess.PIPE, max_bytes=MAX_METADATA_BYTES):
    if not isinstance(url, str) or urlparse(url).scheme not in ("http", "https"):
        fail("release URL must use http or https")
    return subprocess.run(
        ["curl", "--fail", "--silent", "--show-error", "--location",
         "--proto", "=http,https", "--proto-redir", "=http,https",
         "--max-filesize", str(max_bytes),
         "--connect-timeout", "30", "--max-time", "600", url],
        stdout=output, check=True).stdout


# Ctrl-C or a dropped SSH session must reach the cleanup below, like adopt: a partial download
# or extraction left behind makes the next update refuse to overwrite it.
def interrupted(signum, _frame):
    raise InterruptedError(f"update interrupted by signal {signum}")


for signum in (signal.SIGHUP, signal.SIGINT, signal.SIGTERM):
    signal.signal(signum, interrupted)

try:
    manifest = selfhost.parent / "release-manifest.json"
    if not manifest.is_file():
        fail(f"missing current release manifest: {manifest}")
    current = json.loads(manifest.read_text()).get("release_version")
    current_key = version_key(current)
    env_file = selfhost / ".env"
    if not env_file.is_file() or env_file.is_symlink() or env_file.stat().st_mode & 0o777 != 0o600:
        fail("update requires the active release's regular .env with mode 0600")
    settings = read_env(env_file)
    state = (selfhost / value(settings, "CHRONICLE_STATE_DIR", ".")).resolve()
    require_current_owner(selfhost, state, value(settings, "COMPOSE_PROJECT_NAME", "chronicle-selfhost"))
    release = json.loads(curl(sys.argv[3]))
    latest = release.get("tag_name")
    latest_key = version_key(latest)
    version = latest.removeprefix("v")
    name = f"chronicle-selfhost-{version}"
    archive_name = f"{name}.tar.gz"
    checksum_name = archive_name + ".sha256"
    signature_name = checksum_name + ".sig"
    assets = {}
    for asset_name in (archive_name, checksum_name, signature_name):
        matches = [a for a in release.get("assets", []) if a.get("name") == asset_name]
        if len(matches) != 1 or not matches[0].get("browser_download_url"):
            kind = "release signature asset" if asset_name == signature_name else "release asset"
            fail(f"missing or ambiguous {kind}: {asset_name}")
        assets[asset_name] = matches[0]["browser_download_url"]
    print(f"Current: {current}; latest: {latest}", flush=True)
    newer = latest_key > current_key
    if check:
        sys.exit(UPDATE_AVAILABLE_EXIT if newer else 0)
    if not newer:
        fail("latest release is not newer than the current release")

    public_key = selfhost / "release-signing.pub"
    if not public_key.is_file() or public_key.is_symlink():
        fail("missing installed release-signing.pub; cannot verify the release signature")
    key = public_key.read_text().strip()
    if not key.startswith("ssh-ed25519 ") or "\n" in key or "\r" in key:
        fail("invalid installed release-signing.pub; expected one SSH ed25519 public key")

    require_storage(state, value(settings, "COMPOSE_PROJECT_NAME", "chronicle-selfhost"),
                    free_disk_floor(settings), UPDATE_PEAK_BYTES)
    parent = selfhost.parent.parent
    bundle = parent / name
    # A failed exec handoff retains its verified download and clean extraction for retry.
    paths = (bundle, *(parent / asset_name for asset_name in assets))
    reuse = os.path.lexists(bundle)
    recovery_command = (f"cd {shlex.quote(str(bundle / 'selfhost'))} && ./chronicle upgrade --from "
                        f"{shlex.quote(str(selfhost))}")
    if any(path.is_symlink() for path in paths) or any(
            os.path.lexists(path) and not path.is_file() for path in paths[1:]):
        fail("refusing to overwrite unsafe existing release paths")
    asset_root = parent
    if reuse:
        if (not bundle.is_dir()
                or not all(path.is_file() for path in paths[1:])
                or os.path.lexists(bundle / "selfhost" / ".env")):
            fail(f"refusing to overwrite existing release path; inspect the retained bundle. "
                 f"For a clean pre-start failure, retry: {recovery_command}. "
                 "If migrations started, use up/verify or reviewed rollback from that bundle.")
    else:
        staging = tempfile.TemporaryDirectory(prefix=".chronicle-update-", dir=parent)
        asset_root = Path(staging.name)
        for asset_name, url in assets.items():
            path = asset_root / asset_name
            with path.open("xb") as output:
                try:
                    curl(url, output, MAX_ARCHIVE_BYTES if asset_name == archive_name else MAX_METADATA_BYTES)
                except subprocess.CalledProcessError:
                    if asset_name == signature_name:
                        fail("missing or unavailable release signature; nothing extracted or executed")
                    raise
                output.flush()
                os.fsync(output.fileno())

    checksum = asset_root / checksum_name
    with tempfile.TemporaryDirectory(prefix=".chronicle-signature-", dir=parent) as directory:
        allowed = Path(directory) / "allowed_signers"
        allowed.write_text(f"{RELEASE_SIGNER} {key}\n")
        with checksum.open("rb") as message:
            verified = subprocess.run(
                ["ssh-keygen", "-Y", "verify", "-f", str(allowed), "-I", RELEASE_SIGNER,
                 "-n", RELEASE_SIGNER, "-s", str(asset_root / signature_name)],
                stdin=message, capture_output=True, timeout=30)
        if verified.returncode:
            fail("invalid release signature; nothing extracted or executed")
    # Restrict the checksum file to exactly this archive, then verify it in-process:
    # Use the same stdlib hash on Linux and macOS.
    entry = re.fullmatch(r"([0-9a-fA-F]{64}) [ *]" + re.escape(archive_name) + r"\n?",
                         checksum.read_text())
    if not entry:
        fail("bad checksum file: expected one SHA-256 entry for the release archive")
    if file_sha256(asset_root / archive_name) != entry[1].lower():
        fail("bad checksum: release archive verification failed; nothing extracted")

    extracted = bundle if reuse else asset_root / name
    with tarfile.open(asset_root / archive_name, "r:gz") as archive:
        members = []
        unpacked = 0
        for member in archive:
            members.append(member)
            unpacked += member.size
            if len(members) > MAX_ARCHIVE_MEMBERS:
                fail(f"release archive has too many members (> {MAX_ARCHIVE_MEMBERS})")
            if unpacked > MAX_UNPACKED_BYTES:
                fail(f"release archive unpacks to more than {MAX_UNPACKED_BYTES} bytes")
        seen = set()
        for member in members:
            path = PurePosixPath(member.name)
            if (path.is_absolute() or ".." in path.parts or not path.parts
                    or path.parts[0] != name or not (member.isdir() or member.isfile())
                    or path in seen):
                fail(f"unsafe or duplicate release archive member: {member.name!r}")
            seen.add(path)
        manifests = [m for m in members if m.name == f"{name}/release-manifest.json" and m.isfile()]
        if len(manifests) != 1:
            fail("missing new release manifest in archive")
        with archive.extractfile(manifests[0]) as source:
            new_manifest = json.load(source)
        if new_manifest.get("release_version") != version:
            fail("new release manifest does not match the requested release version")
        operators = [m for m in members if m.name == f"{name}/selfhost/chronicle" and m.isfile()]
        if len(operators) != 1 or not operators[0].mode & 0o111:
            fail("missing executable selfhost/chronicle in release archive")
        if not reuse:
            extracted.mkdir(mode=0o755)
        # This script runs under umask 077, so every mkdir would land at 0700. Compose
        # bind-mounts selfhost/ into containers running as their image's user (config-guard
        # as the postgres uid): an owner-only directory fails there as a bare "Permission
        # denied". Set directory modes explicitly; archive members keep their own mode.
        extracted.chmod(0o755)

        def ensure_dir(path):
            if not path.is_dir():
                ensure_dir(path.parent)
                path.mkdir()
                path.chmod(0o755)

        # Extract only ordinary files/directories after validating the entire inventory.
        for member in members:
            if reuse:
                break
            target = asset_root / member.name
            if member.isdir():
                ensure_dir(target)
                target.chmod(member.mode & 0o777)
            else:
                ensure_dir(target.parent)
                with archive.extractfile(member) as source, target.open("xb") as output:
                    shutil.copyfileobj(source, output)
                    target.chmod(member.mode & 0o777)
                    output.flush()
                    os.fsync(output.fileno())
    retained, _ = read_manifest(extracted / "release-manifest.json", True)
    if retained != new_manifest:
        fail("extraction does not match the verified archive manifest")
    changelog = extracted / "CHANGELOG.md"
    if not changelog.is_file() or changelog.is_symlink():
        fail("release archive is missing a regular CHANGELOG.md")
    sections = []
    section_version = None
    section_lines = []
    heading = re.compile(r"^## \[([^\]]+)\]$")

    def save_section():
        if section_version is not None:
            sections.append((section_version, version_key(section_version), "\n".join(section_lines).strip()))

    for line in changelog.read_text(encoding="utf-8").splitlines():
        match = heading.fullmatch(line)
        if match:
            save_section()
            section_lines = []
            candidate = match[1]
            try:
                version_key(candidate)
            except ValueError:
                section_version = None
            else:
                section_version = candidate
        elif section_version is not None:
            section_lines.append(line)
    save_section()

    target_sections = [section for section in sections if section[1] == latest_key]
    if len(target_sections) != 1:
        fail("verified CHANGELOG.md must contain exactly one entry for the target release")
    applicable_sections = [section for section in sections if current_key < section[1] <= latest_key]
    if not applicable_sections:
        fail("verified CHANGELOG.md has no entries between the current and target releases")
    applicable_keys = [section[1] for section in applicable_sections]
    if applicable_keys != sorted(applicable_keys, reverse=True):
        fail("verified CHANGELOG.md release entries are not ordered newest first")
    print(f"Verified bundle changelog ({current} through {version}):", flush=True)
    for section_version, _, section_text in applicable_sections:
        print(f"\n## [{section_version}]", flush=True)
        print(section_text or "(no release notes)", flush=True)

    if staging is not None:
        # Publish the bundle last: asset-only remnants after a hard interruption can be
        # replaced on retry, while an existing bundle is always complete and verified.
        for directory in [extracted, *(path for path in extracted.rglob("*") if path.is_dir())]:
            sync_directory(directory)
        for asset_name in assets:
            durable_replace(asset_root / asset_name, parent / asset_name)
        durable_replace(extracted, bundle)
        staging.cleanup()
        staging = None
    operator = bundle / "selfhost" / "chronicle"
    print(f"Handing off to {operator} upgrade --from {selfhost}", flush=True)
    os.execv(str(operator), [str(operator), "upgrade", "--from", str(selfhost)])
except (OSError, ValueError, KeyError, TypeError, AttributeError, tarfile.TarError,
        subprocess.SubprocessError) as error:
    if staging is not None:
        staging.cleanup()
    sys.exit(f"error: update failed: {error}")
PY
}


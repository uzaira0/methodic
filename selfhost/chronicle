# ------------------------------------------------------------------------------ images
# A published release bundle carries digest-pinned images and simply pulls them. A source
# checkout carries Dockerfiles and no images at all, and `.env` inherits the release
# placeholders from `.env.example` -- which compose rejects with "invalid reference format:
# repository name must be lowercase", naming neither the cause nor the cure. Building them
# here is what makes `clone -> setup -> up` work in a source tree, which is the path the
# README documents and the one every first-time operator takes.
is_source_checkout() {
  [[ -f ../docker/Dockerfile.backend && -f Dockerfile.frontend && -f Dockerfile.caddy ]]
}

# A source checkout keeps the server and dashboard code in git submodules, and a plain
# `git clone` leaves those directories empty. The backend image copies
# `chronicle-server/build.gradle` and four siblings, so an uninitialised checkout fails
# inside Docker with "COPY failed: file not found" naming a path that plainly exists in the
# repository -- which reads as a broken build rather than a missing checkout step.
# chronicle (Android) and chronicle-ios are deliberately absent: neither is part of the
# server build, and chronicle-ios is pinned `update = none`.
SOURCE_SUBMODULES=(chronicle-models chronicle-api chronicle-server rhizome rhizome-client chronicle-web)

ensure_sources() {
  local missing=() m
  for m in "${SOURCE_SUBMODULES[@]}"; do
    [[ -e "../$m/build.gradle" || -e "../$m/package.json" ]] || missing+=("$m")
  done
  ((${#missing[@]})) || return 0
  git -C .. rev-parse --git-dir >/dev/null 2>&1 ||
    die "the source directories ${missing[*]} are empty and this is not a git checkout.
       Use a published release bundle, or clone the repository with its submodules."
  printf '  checking out source for %s — first run only\n' "${missing[*]}"
  git -C .. submodule update --init --recursive -- "${missing[@]}" >/dev/null ||
    die "could not check out the source submodules (${missing[*]}).
       Run this from the repository root and try again:  git submodule update --init"
  for m in "${missing[@]}"; do
    [[ -e "../$m/build.gradle" || -e "../$m/package.json" ]] ||
      die "submodule $m is still empty after checkout — the build cannot proceed"
  done
}

# Local tags for a source build. Deliberately not `latest`: a moving tag on a research
# deployment makes "which code is running?" unanswerable after the fact. The revision is
# part of the tag so a later git pull cannot silently keep running an image built from an
# older checkout.
SOURCE_TAG_PREFIX=chronicle-selfhost
source_image_tag() { printf '%s-%s:source-%s\n' "$SOURCE_TAG_PREFIX" "$1" "${2:0:16}"; }

source_checkout_revision() {

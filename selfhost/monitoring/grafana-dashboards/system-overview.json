{
  "uid": "chronicle-system-overview",
  "title": "Chronicle System Overview",
  "tags": [
    "chronicle",
    "selfhost",
    "operational"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Configuration valid",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "chronicle-victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "chronicle_configuration_valid",
          "datasource": {
            "type": "prometheus",
            "uid": "chronicle-victoriametrics"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto"
      }
    },
    {
      "id": 5,

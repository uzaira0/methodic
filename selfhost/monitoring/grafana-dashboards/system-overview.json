      }
    },
    {
      "id": 9,
      "title": "Web up",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "chronicle-victoriametrics"
      },
      "gridPos": {
        "x": 8,
        "y": 0,

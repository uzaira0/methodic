      "id": 13,
      "title": "Public probe",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "chronicle-victoriametrics"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "chronicle_public_probe_success",
          "datasource": {
            "type": "prometheus",
            "uid": "chronicle-victoriametrics"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto"
      }

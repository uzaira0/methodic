      "id": 51,
      "title": "Transactions",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "chronicle-victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(chronicle_postgres_transactions_total[5m])",
          "datasource": {
            "type": "prometheus",
            "uid": "chronicle-victoriametrics"
          }
        }
      ]
    },
    {
      "id": 63,
      "title": "Deadlocks",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "chronicle-victoriametrics"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(chronicle_postgres_deadlocks_total[1h])",
          "datasource": {
            "type": "prometheus",
            "uid": "chronicle-victoriametrics"
          }
        }
      ]
    },
    {
      "id": 131,

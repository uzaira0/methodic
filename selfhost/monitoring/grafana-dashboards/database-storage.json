        },
        "overrides": []
      }
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "chronicle-victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "text": "unhealthy"
                },
                "1": {
                  "color": "green",
                  "text": "healthy"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 29
      },
      "id": 32,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "chronicle_tde_expected == 0 or chronicle_tde_healthy",
          "refId": "A"
        }
      ],
      "title": "TDE health",
      "type": "stat"
    },

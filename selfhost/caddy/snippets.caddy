# Shared route definitions, imported by the Caddyfile variants.
#
# The route lists below are security-relevant: the public listener's job is to serve
# everything EXCEPT `chronicle_dashboard_api`. Defining them once means the public and
# internal listeners can never drift apart.

(chronicle_common) {
	# Redact at the source, before access events reach the container log driver. Chronicle's
	# custom credential headers are not among Caddy's default credential redactions, and
	# mobile route paths contain participant/study identifiers. Keep only operational fields;
	# Fluent Bit applies a second allowlist before forwarding anything to VictoriaLogs.
	log {
		format filter {
			request>headers delete
			request>uri delete
			request>remote_ip ip_mask 16 32
			request>client_ip ip_mask 16 32
			wrap json
		}
	}
	encode gzip
	request_body {
		max_size 15MB
	}
	import chronicle_security_headers
	import chronicle_rate_limit
}

# Per-client rate limiting. The release app starts its settings, enrollment-monitoring,
# collection, and upload workers together and legitimately emits more than five requests in
# its first second. Keep the edge bucket at 20 req/s so that ordinary startup fits while the
# backend's narrower per-endpoint minute limits remain authoritative. Keyed on {client_ip},
# NOT {remote_host}: behind an institutional load
# balancer every request shares the balancer's address, so {remote_host} would put all
# participants in one bucket and the first busy device would throttle everyone. Caddy
# derives {client_ip} from X-Forwarded-For for the trusted_proxies ranges configured in
# each Caddyfile.
(chronicle_rate_limit) {
	rate_limit {
		zone mobile_ingest {
			match {
				path /chronicle/v2/* /chronicle/v3/* /chronicle/v4/* /chronicle/study/*
				# /chronicle/v3/auth/* is browser traffic that merely happens to live under
				# the mobile prefix, and 5 req/s is the wrong meter for it: one dashboard
				# page load spends two of those five on /auth/session then
				# /auth/testing-login, so a reload, a second tab, or React's double-effect
				# in development pushes a healthy deployment into "Session initialization
				# failed — Testing login request failed with status 429". Metered with the
				# dashboard below instead. Brute-force protection does not depend on this
				# zone: the backend applies its own 10 requests/minute AUTH limit
				# (RateLimitConfiguration.authRequestsPerMinute) to the same paths.
				not path /chronicle/v3/auth/*
			}
			key {client_ip}
			events {$RATE_LIMIT_MOBILE_EVENTS:20}
			window {$RATE_LIMIT_MOBILE_WINDOW:1s}
		}
		zone dashboard {
			match {
				path /chronicle/api/web/* /chronicle/limits/* /chronicle/v3/auth/*
			}
			key {client_ip}
			events {$RATE_LIMIT_WEB_EVENTS:20}
			window {$RATE_LIMIT_WEB_WINDOW:1s}
		}
	}
}

# Applied to every listener. HSTS is emitted only when the request actually arrived over
# TLS -- either terminated here or reported by a trusted upstream proxy via
# X-Forwarded-Proto -- because sending it over plain HTTP is meaningless and pinning a
# host to HTTPS that cannot serve it locks the dashboard out.
(chronicle_security_headers) {
	header {
		-Server
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		Cross-Origin-Opener-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
	}
	@https header X-Forwarded-Proto https
	header @https Strict-Transport-Security "max-age=31536000; includeSubDomains"
	@tls_direct {
		protocol https
	}
	header @tls_direct Strict-Transport-Security "max-age=31536000; includeSubDomains"
}

# Direct backend and admin surfaces. The hardened reference returns 404 for exactly these
# prefixes at Traefik (docker-compose.traefik.yml, router `chronicle-block`); this bundle
# must not be weaker. They are not used by the dashboard, so they are refused on EVERY
# listener, internal included.
(chronicle_deny_direct) {
	respond /datastore/* 404
	respond /chronicle/datastore/* 404
	respond /chronicle/principal/* 404
	respond /chronicle/compliance/* 404
	respond /chronicle/import/* 404
	respond /prometheus/* 404
}

# Certificate files YOU provide, mounted from ./tls by overlays/tls.yml. Never ACME.
(chronicle_tls) {
	tls /etc/caddy/certs/cert.pem /etc/caddy/certs/key.pem
}

(chronicle_health) {
	handle /health {
		rewrite * /chronicle/internal/health/ready
		reverse_proxy backend:40320
	}
}

# App-store policy URLs and reviewer enrollment must remain reachable before any internal
# dashboard password gate. The reviewer path is exact; lookalikes continue through the
# ordinary mobile/security chain and receive no reusable-secret authentication.
(chronicle_public_entrypoints) {
	redir /privacy /chronicle/privacy permanent
	redir /withdrawal /chronicle/withdrawal permanent
	redir /reviewer /chronicle/reviewer permanent
	reverse_proxy /chronicle/v4/mobile/reviewer-enrollment backend:40320
}

# Mobile ingest + the participant web forms. v4 is mobile-only; v3 carries mobile uploads
# AND the participant survey/questionnaire/diary endpoints, so it cannot be locked down
# wholesale — see chronicle_deny_researcher_v3.
(chronicle_mobile) {
	reverse_proxy /chronicle/v2/* backend:40320
	reverse_proxy /chronicle/v3/* backend:40320
	reverse_proxy /chronicle/v4/* backend:40320
	# ChronicleStudyApi is the legacy mobile contract. Production Traefik still routes it
	# for installed clients, so serving index.html here would be a silent compatibility
	# break: every request would report 200 while returning HTML instead of API JSON.
	reverse_proxy /chronicle/study/* backend:40320
}

# Optional perimeter password on the researcher dashboard, on top of whatever network
# isolation you have. Use the guarded command, which reads cleartext only over a silent
# prompt/stdin path, stores the bcrypt hash, recreates Caddy, and verifies the result:
#
#   ./chronicle rotate-secret dashboard
#
# To wire a custom Caddy layout, put the resulting DASHBOARD_PASSWORD_HASH in .env, then add
# `import chronicle_dashboard_gate` to
# the site block ABOVE `import chronicle_dashboard_api` (and above chronicle_spa if you
# want the dashboard assets gated too). Participant paths must NOT be gated — phones and
# participant forms cannot answer a password prompt.
# Guards the INTERNAL listener: subnet/IP allowlist + a single global username and
# password. Three properties matter here, and all three are enforced by construction:
#
#   * the allowlist uses `remote_ip`, the real TCP peer, NOT `client_ip` -- client_ip
#     honours X-Forwarded-For, which a caller can set to anything. The internal listener
#     is reached directly, so the peer address is trustworthy and unspoofable.
#   * the password is only ever stored as a bcrypt hash. Nothing writes the cleartext:
#     `./chronicle setup` and `rotate-secret dashboard` read it silently, send it to the
#     digest-pinned Caddy image over stdin, and keep only the hash.
#   * the listener runs TLS (see the :8081 blocks), so the Basic credentials are never
#     put on the wire in the clear. Basic auth over plain HTTP is cleartext by design.
#
# Order is deliberate: reject a disallowed source BEFORE prompting, so a caller outside
# the allowlist is never invited to send credentials at all.
(chronicle_dashboard_guard) {
	@not_allowed not remote_ip {$DASHBOARD_ALLOWED_IPS}
	respond @not_allowed "Forbidden" 403 {
		close
	}

	basic_auth {
		{$DASHBOARD_USER} {$DASHBOARD_PASSWORD_HASH}
	}
}

(chronicle_dashboard_gate) {
	@dashboard path /chronicle/api/web/* /chronicle/limits/*
	basic_auth @dashboard {
		researcher {$DASHBOARD_PASSWORD_HASH}
	}
}

# Researcher dashboard API.
#
# The dashboard calls a stable, unversioned /chronicle/api/web boundary (its RTK Query
# baseUrl in chronicle-web/src/modern/state/study-operations-api.ts). The backend maps
# those researcher endpoints under the versioned prefix instead -- StudyApi.CONTROLLER is
# "/v3/study" -- so the proxy has to bridge the two. Production does it in Traefik with the
# chronicle-web-strip middleware (^/chronicle/api/web/?(.*) -> /chronicle/v3/${1}); the two
# rewrites must stay identical or the self-host bundle and production disagree about what
# the dashboard can reach.
(chronicle_dashboard_api) {
	# `handle` rather than a named matcher on each directive: the matcher on a `handle` is
	# evaluated once on entry, so the rewrite below cannot make the request stop matching
	# the very block that is rewriting it.
	handle /chronicle/api/web/* {
		uri replace /chronicle/api/web/ /chronicle/v3/ 1

		# Rewritten, the path now starts with "/chronicle/v3/study/", which is one of
		# MobileApiSignatureFilter.MOBILE_API_PREFIXES -- so without this marker the filter
		# demands a mobile HMAC signature from a browser and every dashboard call fails.
		# This is what production injects via chronicle-web-internal-header. The value must
		# equal the backend's CHRONICLE_INTERNAL_WEB_SECRET, which is why both read the same
		# .env variable. The filter compares it in constant time and never accepts a
		# guessable literal in its place (CWE-290).
		#
		# Set, not added: a client-supplied X-Chronicle-Internal-Web is overwritten here, so
		# it can never reach the backend from outside.
		request_header X-Chronicle-Internal-Web {$CHRONICLE_INTERNAL_WEB_SECRET}

		# Bulk exports can run long.
		reverse_proxy backend:40320 {
			transport http {
				read_timeout 300s
			}
		}
	}
	reverse_proxy /chronicle/limits/* backend:40320
}

# The same prefixes, refused. 404 rather than 403 so a probe cannot distinguish
# "exists but forbidden" from "not here".
(chronicle_deny_dashboard_api) {
	respond /chronicle/api/web/* 404
	respond /chronicle/limits/* 404
}

# Researcher authentication. AuthTokenController maps /chronicle/v3/auth, so these sit
# under the same v3 prefix that carries mobile uploads and must be denied explicitly —
# /chronicle/v3/auth/testing-login mints an admin session, and leaving it on the public
# listener would put that on the internet. Participants never authenticate: their forms are
# opened by deep link and post to /chronicle/v3/{survey,time-use-diary}/... directly.
(chronicle_deny_auth) {
	respond /chronicle/v3/auth/* 404
}

# TimeUseDiaryController (/v3/time-use-diary) and SurveyController (/v3/survey) each host
# BOTH participant endpoints and researcher bulk-data downloads. The participant half must
# stay public, so only the researcher half is refused. The backend authorizes all of them
# independently — this is defence in depth, not the only control.
(chronicle_deny_researcher_v3) {
	@researcherOnlyV3 path_regexp ^/chronicle/v3/(time-use-diary/[^/]+/(data|ids|participants/data)|survey/[^/]+/questionnaire/[^/]+/responses)$
	respond @researcherOnlyV3 404
}

# Dashboard SPA. handle_path strips /chronicle so the build output maps cleanly, and
# try_files sends unknown paths to index.html so client-side deep links
# (/chronicle/studies/<id>/participants, /chronicle/survey) resolve on refresh.
(chronicle_spa) {
	# The dashboard can run on a private :8081 listener while phones use a distinct public
	# origin. Stamp the same validated canonical origin used by enrollment manifests so a
	# self-hoster never issues a link for the wrong deployment.
	@runtimeConfig path /chronicle/runtime-config.js
	header @runtimeConfig Content-Type "application/javascript; charset=utf-8"
	respond @runtimeConfig `window.__CHRONICLE_RUNTIME_CONFIG__ = Object.freeze({serverUrl: "{$CHRONICLE_PUBLIC_BASE_URL}", allowPrivateServerUrl: {$CHRONICLE_ALLOW_PRIVATE_ENROLLMENT_ORIGIN:false}});` 200

	handle_path /chronicle/* {
		root * /srv
		try_files {path} /index.html
		file_server
	}
	# /chronicle/* does not match the bare /chronicle, which would otherwise fall
	# through to an empty 200. The README points operators at that exact path.
	redir /chronicle /chronicle/ permanent
	redir / /chronicle/ permanent
}

{
  "realm": "__REALM__",
  "enabled": true,
  "displayName": "Chronicle",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "defaultRoles": [
    "AuthenticatedUser"
  ],
  "rememberMe": false,
  "roles": {
    "realm": [
      {
        "name": "AuthenticatedUser",
        "description": "Baseline Chronicle authenticated user role"
      },
      {
        "name": "admin",
        "description": "Chronicle administrator role"
      }
    ]
  },
  "clients": [
    {
      "clientId": "__CLIENT_ID__",
      "name": "Chronicle Web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "secret": "__CLIENT_SECRET__",
      "redirectUris": [
        "https://__DOMAIN__/chronicle/v3/auth/oidc/callback",
        "http://localhost/chronicle/v3/auth/oidc/callback"
      ],
      "webOrigins": [
        "https://__DOMAIN__",
        "http://localhost"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://__DOMAIN__/chronicle"
      },
      "protocolMappers": [
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "email",
            "claim.name": "email",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "full name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-full-name-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "amr",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "amr",
            "claim.name": "amr",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "identityProviders": [
    {
      "alias": "upstream-oidc",
      "displayName": "Institution SSO",
      "providerId": "oidc",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "authenticateByDefault": false,
      "linkOnly": false,
      "hideOnLogin": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "syncMode": "FORCE",
        "clientId": "__UPSTREAM_OIDC_CLIENT_ID__",
        "clientSecret": "__UPSTREAM_OIDC_CLIENT_SECRET__",
        "clientAuthMethod": "client_secret_post",
        "issuer": "__UPSTREAM_OIDC_ISSUER__",
        "authorizationUrl": "__UPSTREAM_OIDC_AUTH_URL__",
        "tokenUrl": "__UPSTREAM_OIDC_TOKEN_URL__",
        "userInfoUrl": "__UPSTREAM_OIDC_USERINFO_URL__",
        "jwksUrl": "__UPSTREAM_OIDC_JWKS_URL__",
        "useJwksUrl": "true",
        "validateSignature": "true",
        "pkceEnabled": "true",
        "pkceMethod": "S256",
        "defaultScope": "openid profile email",
        "backchannelSupported": "false",
        "disableUserInfo": "false",
        "filteredByClaim": "false",
        "hideOnLoginPage": "false"
      }
    },
    {
      "alias": "upstream-saml",
      "displayName": "Institution SSO (disabled SAML example)",
      "providerId": "saml",
      "enabled": false,
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "authenticateByDefault": false,
      "linkOnly": false,
      "hideOnLogin": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "syncMode": "IMPORT",
        "entityId": "https://idp.example.org/saml",
        "singleSignOnServiceUrl": "https://idp.example.org/saml/sso",
        "singleLogoutServiceUrl": "https://idp.example.org/saml/slo",
        "nameIDPolicyFormat": "urn:oasis:names:tc:SAML:2.0:nameid-format:persistent",
        "principalType": "SUBJECT",
        "validateSignature": "true",
        "signingCertificate": "REPLACE_WITH_UPSTREAM_SAML_SIGNING_CERTIFICATE",
        "wantAuthnRequestsSigned": "true",
        "wantAssertionsSigned": "true",
        "wantAssertionsEncrypted": "false",
        "signSpMetadata": "true",
        "signatureAlgorithm": "RSA_SHA256",
        "xmlSigKeyInfoKeyNameTransformer": "KEY_ID",
        "postBindingResponse": "false",
        "postBindingAuthnRequest": "false",
        "postBindingLogout": "false",
        "backchannelSupported": "false",
        "forceAuthn": "false",
        "hideOnLoginPage": "false",
        "enabledFromMetadata": "true",
        "metadataDescriptorUrl": "https://idp.example.org/saml/metadata"
      }
    }
  ],
  "identityProviderMappers": [
    {
      "name": "Upstream OIDC email",
      "identityProviderAlias": "upstream-oidc",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "claim": "email",
        "user.attribute": "email"
      }
    },
    {
      "name": "Upstream OIDC given_name to firstName",
      "identityProviderAlias": "upstream-oidc",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "claim": "given_name",
        "user.attribute": "firstName"
      }
    },
    {
      "name": "Upstream OIDC family_name to lastName",
      "identityProviderAlias": "upstream-oidc",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "claim": "family_name",
        "user.attribute": "lastName"
      }
    },
    {
      "name": "Upstream OIDC preferred_username to username",
      "identityProviderAlias": "upstream-oidc",
      "identityProviderMapper": "oidc-username-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "template": "${CLAIM.preferred_username}"
      }
    },
    {
      "name": "Upstream OIDC amr passthrough",
      "identityProviderAlias": "upstream-oidc",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "syncMode": "FORCE",
        "claim": "amr",
        "user.attribute": "amr"
      }
    },
    {
      "name": "Upstream SAML mail to email",
      "identityProviderAlias": "upstream-saml",
      "identityProviderMapper": "saml-user-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "attribute.name": "urn:oid:0.9.2342.19200300.100.1.3",
        "attribute.friendly.name": "mail",
        "user.attribute": "email"
      }
    },
    {
      "name": "Upstream SAML givenName to firstName",
      "identityProviderAlias": "upstream-saml",
      "identityProviderMapper": "saml-user-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "attribute.name": "urn:oid:2.5.4.42",
        "attribute.friendly.name": "givenName",
        "user.attribute": "firstName"
      }
    },
    {
      "name": "Upstream SAML sn to lastName",
      "identityProviderAlias": "upstream-saml",
      "identityProviderMapper": "saml-user-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "attribute.name": "urn:oid:2.5.4.4",
        "attribute.friendly.name": "sn",
        "user.attribute": "lastName"
      }
    },
    {
      "name": "Upstream SAML eppn to username",
      "identityProviderAlias": "upstream-saml",
      "identityProviderMapper": "saml-username-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "attribute.name": "urn:oid:1.3.6.1.4.1.5923.1.1.1.6",
        "attribute.friendly.name": "eduPersonPrincipalName",
        "template": "${ATTRIBUTE.urn:oid:1.3.6.1.4.1.5923.1.1.1.6}",
        "target": "LOCAL"
      }
    }
  ]
}

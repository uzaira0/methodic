diff --git a/build/docker/docker_start.sh b/build/docker/docker_start.sh
index 9f42b41..3c885d2 100755
--- a/build/docker/docker_start.sh
+++ b/build/docker/docker_start.sh
@@ -54,6 +54,10 @@ cscli() {
 }
 
 run_hub_update() {
+    if istrue "$NO_HUB_UPDATE"; then
+        echo "Skipping hub update because NO_HUB_UPDATE is enabled"
+        return 0
+    fi
     index_modification_time=$(stat -c %Y /etc/crowdsec/hub/.index.json 2>/dev/null)
     # Run cscli hub update if no date or if the index file is older than 24h
     if [ -z "$index_modification_time" ] || [ $(( $(date +%s) - index_modification_time )) -gt 86400 ]; then
@@ -80,6 +84,10 @@ is_mounted() {
 }
 
 run_hub_update_if_from_volume() {
+    if istrue "$NO_HUB_UPDATE"; then
+        echo "Skipping hub update because NO_HUB_UPDATE is enabled"
+        return 0
+    fi
     if is_mounted "/etc/crowdsec/hub/.index.json"; then
         echo "Running hub update"
         run_hub_update
@@ -213,6 +221,11 @@ prepare_hub() {
         return
     fi
 
+    if istrue "$NO_HUB_MUTATION"; then
+        echo "Skipping all Hub mutation because NO_HUB_MUTATION is enabled"
+        return
+    fi
+
     ## Install hub items
 
     run_hub_update_if_from_volume || true

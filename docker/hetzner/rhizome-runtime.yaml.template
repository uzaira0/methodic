enable-persistence: false
session-clustering-enabled: false

hazelcast:
  server: true
  group: "chronicle-prod"
  password: "${HAZELCAST_SERVER_PASSWORD}"
  cp-member-count: 0
  seed-nodes:
    - "localhost"
  port: 5710

hazelcast-clients:
  IDS:
    server: false
    group: "chronicle-prod"
    password: "${HAZELCAST_CLIENT_PASSWORD}"
    cp-member-count: 0
    seed-nodes:
      - "127.0.0.1:5710"

# The schema and indexes are restored/migrated under the bootstrap role before
# this runtime starts. Keeping both initializers off means chronicle_app needs
# data privileges only; it never needs table ownership or schema CREATE.
postgres:
  citus: false
  initialize-indices: false
  initialize-tables: false
  hikari:
    jdbcUrl: "jdbc:postgresql://postgres:5432/${POSTGRES_DB}?sslmode=verify-full&sslrootcert=/app/ssl/ca.crt"
    username: "${POSTGRES_USER}"
    password: "${POSTGRES_PASSWORD}"
    maximumPoolSize: 20
    minimumIdle: 5
    # Runtime readiness has a 10s healthcheck budget and then validates the
    # connection for up to 2s, so pool acquisition must fail first.
    connectionTimeout: 5000
    idleTimeout: 600000
    maxLifetime: 1800000
    leakDetectionThreshold: 300000

datasources:
  chronicle:
    citus: false
    initialize-indices: false
    initialize-tables: false
    hikari:
      jdbcUrl: "jdbc:postgresql://postgres:5432/${POSTGRES_DB}?sslmode=verify-full&sslrootcert=/app/ssl/ca.crt"
      username: "${POSTGRES_USER}"
      password: "${POSTGRES_PASSWORD}"
      maximumPoolSize: 20
      minimumIdle: 5
      # Keep acquisition within the backend readiness healthcheck budget.
      connectionTimeout: 5000
      idleTimeout: 600000
      maxLifetime: 1800000
      leakDetectionThreshold: 300000

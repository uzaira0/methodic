# Chronicle Production Environment Configuration
# This file is a TEMPLATE. Copy to .env.production.local on the production server
# and fill in real values. NEVER put production secrets in this tracked template.
#
# Secrets should also be configured in GitHub Actions:
#   Repository > Settings > Environments > production > Environment secrets
#
# HIPAA Note: All secrets must be rotated on a regular schedule.
# Document rotation dates in your compliance tracking system.

# =============================================================================
# DOMAIN
# =============================================================================
DOMAIN=chronicle.example.com
CHRONICLE_PUBLIC_BASE_URL=https://chronicle.example.com

# =============================================================================
# DOCKER IMAGE REFERENCES (set by CD pipeline via deploy.sh flags)
# =============================================================================
BACKEND_IMAGE=ghcr.io/uzaira0/chronicle/chronicle-backend
FRONTEND_IMAGE=ghcr.io/uzaira0/chronicle/chronicle-frontend
# Use the CD-produced sha-* or v* tag. Do not deploy mutable tags such as latest or main.
IMAGE_TAG=CHANGE_ME_IMMUTABLE_IMAGE_TAG

# =============================================================================
# POSTGRESQL
# =============================================================================
POSTGRES_USER=chronicle
POSTGRES_PASSWORD=CHANGE_ME_PRODUCTION_DB_PASSWORD
POSTGRES_DB=chronicle
# HIPAA: Use verify-full for production to validate server certificate + hostname
POSTGRES_SSL_MODE=verify-full

# =============================================================================
# AUTHENTICATION
# =============================================================================
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_PRODUCTION_JWT_SECRET
OIDC_ENABLED=true
TESTING_LOGIN_ENABLED=false
ALLOW_PRODUCTION_TESTING_LOGIN=false
OIDC_PROVIDER_LABEL=Institution SSO
OIDC_REALM=chronicle
OIDC_CLIENT_ID=chronicle-web
OIDC_CLIENT_SECRET=CHANGE_ME_PRODUCTION_OIDC_CLIENT_SECRET
OIDC_IDP_HINT=upstream-oidc
OIDC_COOKIE_TOKEN_CLAIM=id_token
# Must select the same broker as OIDC_IDP_HINT. The disabled upstream SAML example is blocked
# until current-session AuthnContext-to-amr/acr mapping is implemented and proved.
KEYCLOAK_DEFAULT_IDP=upstream-oidc
UPSTREAM_OIDC_CLIENT_ID=CHANGE_ME_UPSTREAM_ISSUED_CLIENT_ID
UPSTREAM_OIDC_CLIENT_SECRET=CHANGE_ME_UPSTREAM_ISSUED_CLIENT_SECRET
UPSTREAM_OIDC_ISSUER=https://idp.example.org
UPSTREAM_OIDC_AUTH_URL=https://idp.example.org/authorize
UPSTREAM_OIDC_TOKEN_URL=https://idp.example.org/token
UPSTREAM_OIDC_USERINFO_URL=https://idp.example.org/userinfo
UPSTREAM_OIDC_JWKS_URL=https://idp.example.org/jwks

# =============================================================================
# HAZELCAST CLUSTER
# =============================================================================
# Generate with: openssl rand -base64 32
HAZELCAST_SERVER_PASSWORD=CHANGE_ME_PRODUCTION_HZ_SERVER
HAZELCAST_CLIENT_PASSWORD=CHANGE_ME_PRODUCTION_HZ_CLIENT

# =============================================================================
# MOBILE API
# =============================================================================
# Public Play clients use enrollment-issued per-device API keys. These three settings are
# one controlled-legacy opt-in: enable both flags and set a 32+ character key together only
# when an operator intentionally supports a closed legacy/research-client fleet.
MOBILE_SIGNING_SECRET=
CHRONICLE_INTERNAL_WEB_SECRET=CHANGE_ME_PRODUCTION_INTERNAL_WEB_SECRET
MOBILE_SIGNING_ENABLED=false
MOBILE_SIGNING_REQUIRED=false

# =============================================================================
# SECURITY
# =============================================================================
# Production traffic terminates TLS before the backend, but browser-facing auth
# cookies must still be marked Secure.
CHRONICLE_SECURITY_COOKIE_SECURE=true
# Secure application default and production preflight both require MFA.
CHRONICLE_SECURITY_REQUIRE_MFA=true
# Exact comma-separated ACR allowlist; keep empty until the IdP contract and
# live MFA/non-MFA token pair prove the current-session value.
CHRONICLE_SECURITY_APPROVED_MFA_ACR_VALUES=
# Fail-closed release attestation. Change to true only after attaching redacted
# live MFA/non-MFA token evidence for the selected institutional broker.
CHRONICLE_SECURITY_MFA_IDP_PROOF_VERIFIED=false

# CrowdSec WAF bouncer API key
CROWDSEC_BOUNCER_API_KEY=CHANGE_ME_PRODUCTION_CROWDSEC_KEY

# =============================================================================
# JVM TUNING (production gets more memory)
# =============================================================================
BACKEND_XMS=-Xms1g
BACKEND_XMX=-Xmx3g

# =============================================================================
# ENCRYPTION AT REST (TDE)
# =============================================================================
# HIPAA: Use vault provider for production key management
PG_TDE_KEY_PROVIDER=vault
PG_TDE_VAULT_URL=https://vault.example.com:8200
PG_TDE_VAULT_TOKEN=CHANGE_ME_VAULT_TOKEN
PG_TDE_VAULT_MOUNT_PATH=secret
# PG_TDE_VAULT_CA_PATH=/etc/ssl/certs/vault-ca.pem

# =============================================================================
# EMAIL
# =============================================================================
SMTP_ENABLED=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME_SMTP_USER
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM_EMAIL=noreply@chronicle.example.com

# =============================================================================
# VAULT
# =============================================================================
VAULT_ENABLED=true
VAULT_ADDR=https://vault.example.com:8200
VAULT_TOKEN=CHANGE_ME_VAULT_TOKEN

# =============================================================================
# MONITORING
# =============================================================================
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_PRODUCTION_GRAFANA_PASSWORD
GF_SECURITY_COOKIE_SECURE=true

# =============================================================================
# TRAEFIK
# =============================================================================
TRAEFIK_NETWORK=traefik-apps
TRAEFIK_ENTRYPOINT=web
TRAEFIK_BIND_IP=127.0.0.1
# Internal hostname (Docker host that the upstream proxy forwards to)
# INTERNAL_HOST=your-docker-host.example.com

# =============================================================================
# BUILD METADATA (set by CD pipeline)
# =============================================================================
GIT_SHA=unknown

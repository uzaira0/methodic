# Chronicle Production Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# =============================================================================
# REQUIRED SETTINGS
# =============================================================================

# Your domain name (e.g., chronicle.yourdomain.com)
DOMAIN=chronicle.example.com
# Exact public HTTPS root used in signed mobile enrollment manifests.
CHRONICLE_PUBLIC_BASE_URL=https://chronicle.example.com

# PostgreSQL credentials - USE STRONG PASSWORDS IN PRODUCTION
POSTGRES_USER=chronicle
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
POSTGRES_DB=chronicle

# JWT secret for signing tokens - generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING

# JWT Algorithm: HS256 (default) or RS256
JWT_ALGORITHM=HS256
# For RS256 only:
# JWT_PUBLIC_KEY_PATH=/app/ssl/jwt-public.pem
# JWT_PRIVATE_KEY_PATH=/app/ssl/jwt-private.pem

# JWT access token expiry in minutes (default: 15)
# ACCESS_TOKEN_EXPIRY_MINUTES=15

# Refresh token expiry in days (default: 7)
# REFRESH_TOKEN_EXPIRY_DAYS=7

# Require MFA (multi-factor authentication) via the RFC 8176 amr claim.
# Production deploy validation requires true. Confirm the IdP emits explicit
# mfa, pwd+possession, or an approved current-session acr before user traffic.
# See docs/security/compliance-evidence/W3-mfa-enforcement.md (HIPAA §164.312(d)).
CHRONICLE_SECURITY_REQUIRE_MFA=true
# Optional comma-separated exact ACR values trusted as MFA assertions.
# Leave empty until the institutional IdP contract and a live token prove the value.
CHRONICLE_SECURITY_APPROVED_MFA_ACR_VALUES=
# Production attestation. Keep false until redacted live MFA and non-MFA tokens
# prove the selected broker's current-session assurance semantics.
CHRONICLE_SECURITY_MFA_IDP_PROOF_VERIFIED=false

# =============================================================================
# LOCAL SSO BROKER (KEYCLOAK OIDC)
# =============================================================================

# Set OIDC_ENABLED=true after starting the sso profile:
#   docker compose -f docker-compose.traefik.yml --profile sso up -d keycloak
# Connect an operator-selected upstream OIDC provider to Keycloak. Chronicle
# only needs OIDC from Keycloak.
OIDC_ENABLED=false
TESTING_LOGIN_ENABLED=false
ALLOW_PRODUCTION_TESTING_LOGIN=false
OIDC_PROVIDER_LABEL=Institution SSO
OIDC_REALM=chronicle
OIDC_CLIENT_ID=chronicle-web
OIDC_CLIENT_SECRET=CHANGE_ME_WITH_OPENSSL_RAND_BASE64_32
# Which Keycloak broker the backend hints (kc_idp_hint). Keep in sync with
# KEYCLOAK_DEFAULT_IDP below. The supported public example is upstream-oidc,
# which passes amr/MFA through natively.
OIDC_IDP_HINT=upstream-oidc
OIDC_COOKIE_TOKEN_CLAIM=id_token
OIDC_PUBLIC_BASE_URL=https://${DOMAIN}
OIDC_ISSUER=https://${DOMAIN}/keycloak/realms/${OIDC_REALM}
OIDC_AUTHORIZATION_URI=https://${DOMAIN}/keycloak/realms/${OIDC_REALM}/protocol/openid-connect/auth
OIDC_TOKEN_URI=http://keycloak:8080/keycloak/realms/${OIDC_REALM}/protocol/openid-connect/token
OIDC_JWKS_URI=http://keycloak:8080/keycloak/realms/${OIDC_REALM}/protocol/openid-connect/certs

# Cookie security
# Set to false for intranet-only HTTP access (local tablet QA workflows).
# Keep true when HTTPS is terminating client traffic (production-like auth flow).
CHRONICLE_SECURITY_COOKIE_SECURE=false

# Required only when enabling the sso profile.
KEYCLOAK_DB=chronicle_keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=CHANGE_ME_WITH_OPENSSL_RAND_BASE64_32
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_WITH_OPENSSL_RAND_BASE64_32
KEYCLOAK_PUBLIC_URL=https://${DOMAIN}/keycloak

# --- Upstream institutional IdP attached to Keycloak ---------------------------
# Chronicle never talks to the upstream identity provider directly; Keycloak
# brokers it. KEYCLOAK_DEFAULT_IDP selects the operator-configured broker. The
# tracked upstream-saml example is disabled and rejected by production startup.
KEYCLOAK_DEFAULT_IDP=upstream-oidc

# operator-supplied upstream OIDC provider — register Chronicle's Keycloak as an OIDC relying party
# with the upstream identity provider and paste the issued credentials here.
# Redirect/callback URI:
# https://${DOMAIN}/keycloak/realms/${OIDC_REALM}/broker/upstream-oidc/endpoint
# Replace every reserved example endpoint below and verify current-session MFA
# assurance before setting CHRONICLE_SECURITY_MFA_IDP_PROOF_VERIFIED=true.
UPSTREAM_OIDC_CLIENT_ID=CHANGE_ME_UPSTREAM_ISSUED_CLIENT_ID
UPSTREAM_OIDC_CLIENT_SECRET=CHANGE_ME_UPSTREAM_ISSUED_CLIENT_SECRET
UPSTREAM_OIDC_ISSUER=https://idp.example.org
UPSTREAM_OIDC_AUTH_URL=https://idp.example.org/authorize
UPSTREAM_OIDC_TOKEN_URL=https://idp.example.org/token
UPSTREAM_OIDC_USERINFO_URL=https://idp.example.org/userinfo
UPSTREAM_OIDC_JWKS_URL=https://idp.example.org/jwks

# Public apps authenticate after enrollment with an enrollment-issued per-device API key.
# Keep the deployment-wide HMAC compatibility path disabled and blank. Enable both flags
# and generate a 32+ character secret only for an explicitly controlled legacy fleet.
MOBILE_SIGNING_ENABLED=false
MOBILE_SIGNING_REQUIRED=false
MOBILE_SIGNING_SECRET=

# Proxy-injected secret that authenticates the internal-web signing bypass
# (X-Chronicle-Internal-Web). Traefik injects it on /chronicle/api/web and the
# backend requires it verbatim, so a caller on the backend network cannot forge
# the bypass with the guessable literal "true" (CWE-290). Generate an
# unguessable value with `openssl rand -base64 32`. Must be identical for the
# backend and Traefik; production startup refuses an empty value.
CHRONICLE_INTERNAL_WEB_SECRET=CHANGE_ME_WITH_OPENSSL_RAND_BASE64_32

# Hazelcast cluster passwords - generate with: openssl rand -base64 32
HAZELCAST_SERVER_PASSWORD=CHANGE_ME_TO_HAZELCAST_SERVER_PASSWORD
HAZELCAST_CLIENT_PASSWORD=CHANGE_ME_TO_HAZELCAST_CLIENT_PASSWORD

# =============================================================================
# OPTIONAL SETTINGS
# =============================================================================

# Backend JVM memory settings
BACKEND_XMS=-Xms512m
BACKEND_XMX=-Xmx2g

# CORS allowed origins (comma-separated)
# Default: https://${DOMAIN}
# CORS_ORIGINS=https://chronicle.example.com,https://admin.example.com

# =============================================================================
# DATA ENCRYPTION AT REST (TDE) SETTINGS
# Required for HIPAA/GDPR compliance - encrypts PostgreSQL data on disk
# =============================================================================

# Key Provider: "file" (development), "vault" (production), "none" (disabled)
# WARNING: "file" provider stores keys unencrypted - use only for development!
PG_TDE_KEY_PROVIDER=file

# HashiCorp Vault Configuration (required when PG_TDE_KEY_PROVIDER=vault)
# For production deployments, use Vault for secure key management
#
# Example Vault URL: https://vault.example.com:8200
# PG_TDE_VAULT_URL=https://vault.example.com:8200
#
# Vault token with permissions to read/write secrets
# Generate with: vault token create -policy=chronicle-tde
# PG_TDE_VAULT_TOKEN=hvs.XXXXXXXXXXXXXXXXXXXX
#
# Vault secrets engine mount path (default: secret)
# PG_TDE_VAULT_MOUNT_PATH=secret
#
# Path to Vault CA certificate (for self-signed certs)
# PG_TDE_VAULT_CA_PATH=/etc/ssl/certs/vault-ca.pem

# =============================================================================
# POSTGRESQL SSL/TLS SETTINGS (Encryption in Transit)
# Required for HIPAA compliance - encrypts data between application and database
# =============================================================================

# SSL Mode for PostgreSQL connections
# Options:
#   disable     - No SSL (NOT recommended for production)
#   allow       - Try non-SSL first, then SSL if server requires
#   prefer      - Try SSL first, then non-SSL (default PostgreSQL behavior)
#   require     - Require SSL, no server certificate verification (MINIMUM for production)
#   verify-ca   - Require SSL, verify server certificate is signed by trusted CA
#   verify-full - Require SSL, verify server certificate and hostname match (RECOMMENDED)
#
# PRODUCTION: the backend JDBC URL hardcodes sslmode=verify-full (in
# rhizome-docker.yaml.template) — the strongest mode: it encrypts the connection
# AND verifies the server certificate is signed by the trusted CA AND that the
# certificate hostname matches. This env var is NO LONGER read by the prod JDBC
# URL; it is retained only for non-prod overrides (e.g. local/dev compose stacks
# that interpolate ${POSTGRES_SSL_MODE} elsewhere). Do not weaken below
# verify-full for any production-facing deployment.
#
# HIPAA Requirement: verify-full (enforced in the prod JDBC URL).
POSTGRES_SSL_MODE=verify-full

# Path to CA certificate for server certificate verification
# Used when POSTGRES_SSL_MODE is verify-ca or verify-full
# Default: Mounted from ./postgres-ssl/ca/ca.crt in docker-compose
# POSTGRES_SSL_ROOT_CERT=/app/ssl/ca.crt

# =============================================================================
# TLS NOTE
# =============================================================================
# TLS is terminated at your upstream load balancer.
# Traefik receives plain HTTP on port 80. Certs in docker/postgres-ssl/ are
# retained for PostgreSQL SSL only (server.crt/server.key used by the postgres
# service). No Let's Encrypt configuration is needed.

# =============================================================================
# SMTP / EMAIL SETTINGS
# Used by mail.yaml.template for backend email notifications
# =============================================================================

# Enable or disable email sending (default: false)
SMTP_ENABLED=false

# SMTP server hostname (e.g., smtp.office365.com for Outlook 365)
SMTP_HOST=smtp.example.com

# SMTP port: 587 for STARTTLS, 465 for implicit SSL
SMTP_PORT=587

# SMTP authentication credentials
SMTP_USERNAME=noreply@example.com
SMTP_PASSWORD=CHANGE_ME_TO_SMTP_PASSWORD

# Sender email address (From header)
SMTP_FROM_EMAIL=noreply@example.com

# =============================================================================
# GRAFANA SETTINGS
# =============================================================================

# Grafana admin password (default: admin)
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_TO_GRAFANA_PASSWORD

# =============================================================================
# HASHICORP VAULT SETTINGS (optional — secret management)
# Enable with: docker compose --profile vault -f docker-compose.traefik.yml up
# =============================================================================

# Enable Vault integration (default: false — uses env vars/YAML for secrets)
VAULT_ENABLED=false

# Vault server address
VAULT_ADDR=http://vault:8200

# Authentication method: "token" (simple) or "approle" (production)
VAULT_AUTH_METHOD=token

# Token auth (for dev/simple deployments)
VAULT_TOKEN=

# AppRole auth (for production — more secure, auto-rotating tokens)
# Get these from: docker compose --profile vault logs vault | grep "AppRole"
VAULT_APP_ROLE_ID=
VAULT_APP_ROLE_SECRET_ID=

# Dev mode root token (only used by the vault container in dev profile)
VAULT_DEV_ROOT_TOKEN=chronicle-dev-token

# =============================================================================
# TRAEFIK SETTINGS (for docker-compose.traefik.yml)
# =============================================================================

# Name of the external Traefik network
TRAEFIK_NETWORK=traefik-apps

# Traefik entrypoint — the upstream proxy terminates TLS; Traefik receives HTTP on :80
TRAEFIK_ENTRYPOINT=web

# Bind IP for Traefik — restricts which interface Traefik listens on.
# Set to the static IP of the Docker host that the load balancer pool member
# targets. Unset it and Traefik binds loopback only, which is safe but not
# reachable from anywhere else; 0.0.0.0 binds every interface.
# TRAEFIK_BIND_IP=127.0.0.1

# Internal hostname (the Docker host that the upstream proxy forwards to).
# Used only for direct maintenance access; all routers use DOMAIN above.
# INTERNAL_HOST=your-docker-host.example.com

# Optional preprocessing UI build output. The default is relative to docker/.
# PREPROCESSING_WEB_DIST=../preprocessing-web/dist

# =============================================================================
# TEMPORAL WORKFLOW ENGINE (optional — for docker-compose.temporal.yml)
# Provides durable workflow execution for notifications, uploads, scheduled ops
# =============================================================================

# Temporal databases (auto-created by auto-setup image)
# These are separate from the main Chronicle database
TEMPORAL_DB=temporal
TEMPORAL_VISIBILITY_DB=temporal_visibility
